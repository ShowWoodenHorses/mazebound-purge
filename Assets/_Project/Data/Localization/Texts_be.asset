  _texts:
  - "\u0411\u0435\u043B\u0430\u0440\u0443\u0441\u043A\u0430\u044F"
  - "\u0428\u0442\u043E\u0434\u0437\u0451\u043D\u043D\u044B\u044F \u0437\u0430\u0434\u0430\u043D\u043D\u0456"
  - "\u0428\u0442\u043E\u0434\u0437\u0451\u043D\u043D\u044B\u044F \u045E\u0437\u043D\u0430\u0433\u0430\u0440\u043E\u0434\u044B"
  - "\u0417\u0430\u0434\u0430\u043D\u043D\u0456 \u0437\u043C\u044F\u043D\u044F\u044E\u0446\u0446\u0430
    \u0430\u043F\u043E\u045E\u043D\u0430\u0447\u044B \u043F\u0430\u0432\u043E\u0434\u043B\u0435
    \u043C\u044F\u0441\u0446\u043E\u0432\u0430\u0433\u0430 \u0447\u0430\u0441\u0443.
    \u0417\u0430\u0431\u044F\u0440\u044B \u045E\u0437\u043D\u0430\u0433\u0430\u0440\u043E\u0434\u044B
    \u0434\u0430 \u0430\u0431\u043D\u0430\u045E\u043B\u0435\u043D\u043D\u044F."
  - "\u0417\u0430\u0431\u0456\u0440\u0430\u0439 \u0440\u0430\u0437 \u043D\u0430 \u0434\u0437\u0435\u043D\u044C.
    \u041F\u0430\u0441\u043B\u044F \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0443
    \u043F\u0440\u0430\u0446\u044F\u0433\u043D\u0435\u0448 \u0437 \u0442\u0430\u0433\u043E
    \u0436 \u043C\u0435\u0441\u0446\u0430."
  - "\u0417\u0430\u0431\u0456 \u043C\u043E\u043D\u0441\u0442\u0440\u0430\u045E: {0}"
  - "\u0417\u0430\u0447\u044B\u0441\u0446\u0456 \u0445\u0432\u0430\u043B\u044E {0}
    \u0443 \u043A\u0430\u043C\u043F\u0430\u043D\u0456\u0456 \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0430\u043D\u0430\u0441\u0446\u0456
    \xAB{1}\xBB \u0430\u0431\u043E \u0432\u044B\u0448\u044D\u0439"
  - "\u0417\u0430\u0447\u044B\u0441\u0446\u0456 \u0445\u0432\u0430\u043B\u0456: {0}"
  - "\u0417\u0430\u0434\u0443\u0448\u044B \u043C\u043E\u043D\u0441\u0442\u0440\u0430\u045E
    \u043C\u0430\u0448\u044B\u043D\u0430\u0439: {0}"
  - "\u0414\u0437\u0435\u043D\u044C {0}"
  - "\u0417\u0430\u0431\u0440\u0430\u0446\u044C {0}"
  - "\u0410\u0442\u0440\u044B\u043C\u0430\u043D\u0430"
  - "\u041D\u0430\u0441\u0442\u0443\u043F\u043D\u0430\u044F \u045E\u0437\u043D\u0430\u0433\u0430\u0440\u043E\u0434\u0430
    \u0437\u0430\u045E\u0442\u0440\u0430"
  - "\u041D\u0435 \u045E\u0434\u0430\u043B\u043E\u0441\u044F \u0430\u0442\u0440\u044B\u043C\u0430\u0446\u044C
    \u0443\u0437\u043D\u0430\u0433\u0430\u0440\u043E\u0434\u0443."
