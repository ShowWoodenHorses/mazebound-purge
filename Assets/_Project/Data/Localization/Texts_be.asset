  - "\u0423\u0442\u0440\u044B\u043C\u043B\u0456\u0432\u0430\u0439\u0446\u0435 \u043A\u043D\u043E\u043F\u043A\u0443
    \u0441\u043B\u043E\u0442\u0430 \u0437 \u043F\u0430\u0434\u0430\u0431\u0440\u0430\u043D\u0430\u0439
    \u0437\u0431\u0440\u043E\u044F\u0439, \u043A\u0430\u0431 \u043A\u0456\u043D\u0443\u0446\u044C
    \u044F\u0435."
  - "\u041D\u0430\u0446\u0456\u0441\u043D\u0456\u0446\u0435 G \u0430\u0431\u043E
    \u043B\u0435\u0432\u044B \u043A\u0443\u0440\u043E\u043A \u0456 \u0432\u044B\u0431\u0435\u0440\u044B\u0446\u0435
    \u043C\u0435\u0441\u0446\u0430 \u043A\u0456\u0434\u043A\u0430. \u041F\u0430\u0441\u043B\u044F
    \u043A\u0456\u0434\u043A\u0430 \u043F\u0430\u0447\u043D\u0435\u0446\u0446\u0430
    \u043F\u0435\u0440\u0448\u0430\u044F \u0445\u0432\u0430\u043B\u044F."
  - "\u0410\u0434\u0431\u0456\u0446\u0435 \u043F\u0435\u0440\u0448\u0443\u044E \u0445\u0432\u0430\u043B\u044E
    \u0456 \u0432\u044B\u0431\u0435\u0440\u044B\u0446\u0435 \u043A\u0430\u0440\u0442\u043A\u0443
    \u043F\u0430\u043B\u044F\u043F\u0448\u044D\u043D\u043D\u044F."
  - "\u041F\u0430\u043C\u0456\u0436 \u0445\u0432\u0430\u043B\u044F\u043C\u0456 \u043F\u0430\u0447\u0430\u043A\u0430\u0439\u0446\u0435
    \u0430\u0431\u043E \u043D\u0430\u0446\u0456\u0441\u043D\u0456\u0446\u0435 \xAB\u041F\u0440\u0430\u043F\u0443\u0441\u0446\u0456\u0446\u044C\xBB,
    \u043A\u0430\u0431 \u043F\u0430\u0447\u0430\u0446\u044C \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0443\u044E."
  - "\u0421\u0430\u0447\u044B\u0446\u0435 \u0437\u0430 \u0430\u0444\u0456\u0446\u044D\u0440\u0430\u043C,
    \u044F\u043A\u0456 \u0441\u0442\u0440\u0430\u043B\u044F\u0435 \u0437\u0434\u0430\u043B\u0451\u043A.
    \u041A\u0430\u043B\u0456 \u0437'\u044F\u0432\u0456\u0446\u0446\u0430 \u043F\u0430\u043F\u044F\u0440\u044D\u0434\u0436\u0430\u043D\u043D\u0435,
    \u0441\u044B\u0434\u0437\u0456\u0446\u0435 \u0437 \u043B\u0456\u043D\u0456\u0456
    \u0430\u0433\u043D\u044E. \u0417\u0430\u0432\u044F\u0440\u0448\u044B\u0446\u0435
    \u0445\u0432\u0430\u043B\u044E, \u043A\u0430\u0431 \u0443\u0431\u0430\u0447\u044B\u0446\u044C
    \u0432\u044B\u043D\u0456\u043A."
  - "\u0414\u0430\u0439\u0434\u0437\u0456\u0446\u0435 \u0434\u0430 \u043F\u0430\u0437\u043D\u0430\u043A\u0456"
  - "\u0426\u044D\u043B\u044C\u0446\u0435\u0441\u044F \u043F\u0440\u0430\u0432\u044B\u043C
    \u0441\u0442\u044B\u043A\u0430\u043C \u0430\u0431\u043E \u043D\u0430\u0446\u0456\u0441\u043D\u0456\u0446\u0435
    \u043A\u043D\u043E\u043F\u043A\u0443 \u0430\u0442\u0430\u043A\u0456 \u045E \u0440\u044D\u0436\u044B\u043C\u0435
    \u0430\u0434\u043D\u0430\u0433\u043E \u0441\u0442\u044B\u043A\u0430."
  - "\u041F\u0430\u0434\u044B\u0434\u0437\u0456\u0446\u0435 \u0434\u0430 \u043F\u0430\u0437\u043D\u0430\u0447\u0430\u043D\u0430\u0439
    \u0437\u0431\u0440\u043E\u0456 \u0456 \u043D\u0430\u0446\u0456\u0441\u043D\u0456\u0446\u0435
    \u043A\u043D\u043E\u043F\u043A\u0443 \u0434\u0437\u0435\u044F\u043D\u043D\u044F."
  - "\u041D\u0430\u0446\u0456\u0441\u043D\u0456\u0446\u0435 \u043D\u0430 \u0456\u043D\u0448\u044B
    \u0441\u043B\u043E\u0442 \u0437\u0431\u0440\u043E\u0456."
  - "\u041D\u0430\u0446\u0456\u0441\u043D\u0456\u0446\u0435 \u043A\u043D\u043E\u043F\u043A\u0443
    \u0433\u0440\u0430\u043D\u0430\u0442\u044B, \u0437\u0430\u0442\u044B\u043C \u043C\u0435\u0441\u0446\u0430
    \u043A\u0456\u0434\u043A\u0430. \u041F\u0430\u0441\u043B\u044F \u043A\u0456\u0434\u043A\u0430
    \u043F\u0430\u0447\u043D\u0435\u0446\u0446\u0430 \u043F\u0435\u0440\u0448\u0430\u044F
    \u0445\u0432\u0430\u043B\u044F."
  - "\u0413\u0443\u043B\u044C\u043D\u044F\u0432\u044B\u044F \u043F\u0430\u0434\u043A\u0430\u0437\u043A\u0456"
  - "\u041A\u0443\u043F\u0456 Desert, \u043A\u0430\u0431 \u043F\u0430\u0447\u0430\u0446\u044C
    \u043F\u0435\u0440\u0448\u044B \u045E\u0437\u0440\u043E\u0432\u0435\u043D\u044C."
  - "\u041F\u0410\u0414\u041A\u0410\u0417\u041A\u0410"
  - "\u0413\u043B\u0443\u0448\u044B\u0446\u0435\u043B\u044C \u0446\u0456\u0448\u044D\u0439
    \u0440\u043E\u0431\u0456\u0446\u044C \u0441\u0442\u0440\u044D\u043B\u044B, \u0456
    \u0446\u044F\u0431\u0435 \u0447\u0443\u0435 \u043C\u0435\u043D\u0448 \u043C\u043E\u043D\u0441\u0442\u0440\u0430\u045E."
  - "\u0410\u0444\u0456\u0446\u044D\u0440 \u0430\u0442\u0430\u043A\u0443\u0435 \u0437\u0434\u0430\u043B\u0451\u043A.
    \u0412\u044B\u0439\u0434\u0437\u0456 \u0437 \u043F\u0430\u0437\u043D\u0430\u0447\u0430\u043D\u0430\u0439
    \u0437\u043E\u043D\u044B \u0434\u0430 \u045E\u0434\u0430\u0440\u0443."
  - "\u0428\u0430\u043C\u0430\u043D \u0430\u0436\u044B\u045E\u043B\u044F\u0435 \u0437\u0430\u0433\u0456\u043D\u0443\u043B\u044B\u0445
    \u043C\u043E\u043D\u0441\u0442\u0440\u0430\u045E. \u0417\u043D\u0456\u0448\u0447\u044B
    \u044F\u0433\u043E, \u043A\u0430\u0431 \u0441\u043F\u044B\u043D\u0456\u0446\u044C
    \u043F\u0430\u0434\u043C\u0430\u0446\u0430\u0432\u0430\u043D\u043D\u0435."
  - "\u0411\u0440\u0430\u043D\u044F\u0432\u0430\u043D\u044B \u0432\u043E\u0440\u0430\u0433
    \u0430\u0442\u0440\u044B\u043C\u043B\u0456\u0432\u0430\u0435 \u043C\u0435\u043D\u0448
    \u0443\u0440\u043E\u043D\u0443 \u0441\u043F\u0435\u0440\u0430\u0434\u0443. \u0421\u0442\u0440\u0430\u043B\u044F\u0439
    \u0437\u0431\u043E\u043A\u0443 \u0446\u0456 \u0437\u0437\u0430\u0434\u0443."
  - "\u0410\u0441\u0430\u0431\u043B\u0456\u0432\u044B\u044F \u045E\u043B\u0430\u0441\u0446\u0456\u0432\u0430\u0441\u0446\u0456
    \u0440\u043E\u0431\u044F\u0446\u044C \u0447\u044D\u043C\u043F\u0456\u0451\u043D\u0430\u045E
    \u0431\u043E\u043B\u044C\u0448 \u043D\u0435\u0431\u044F\u0441\u043F\u0435\u0447\u043D\u044B\u043C\u0456
    \u0437\u0430 \u0437\u0432\u044B\u0447\u0430\u0439\u043D\u044B\u0445 \u043C\u043E\u043D\u0441\u0442\u0440\u0430\u045E."
  - "\u041A\u0440\u0443\u043A \u043C\u043E\u0436\u0430 \u043F\u0440\u044B\u0446\u044F\u0433\u043D\u0443\u0446\u044C
    \u0446\u044F\u0431\u0435. \u0410\u0434\u044B\u0434\u0437\u0456 \u045E\u0431\u043E\u043A,
    \u043A\u0430\u043B\u0456 \u0451\u043D \u0440\u044B\u0445\u0442\u0443\u0435 \u0430\u0442\u0430\u043A\u0443."
  - "\u0410\u0434\u043A\u0440\u044B\u0439 \u0437\u0432\u044B\u0447\u0430\u0439\u043D\u044B
    \u043A\u0443\u0444\u0430\u0440, \u043A\u0430\u0431 \u0437\u0430\u0431\u0440\u0430\u0446\u044C
    \u0437\u0434\u0430\u0431\u044B\u0447\u0443."
  - "\u0417\u0430\u043C\u043A\u043D\u0451\u043D\u044B \u043A\u0443\u0444\u0430\u0440
    \u043F\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u043A\u043B\u044E\u0447\u0430.
    \u0423 \u0456\u043C \u0431\u043E\u043B\u044C\u0448 \u0440\u044D\u0434\u043A\u0430\u044F
    \u0437\u0431\u0440\u043E\u044F."
  - "\u0413\u044D\u0442\u044B \u043A\u0443\u0444\u0430\u0440 \u0432\u044B\u043A\u043B\u0456\u043A\u0430\u0435
    \u0447\u044D\u043C\u043F\u0456\u0451\u043D\u0430\u045E. \u041F\u0435\u0440\u0430\u043C\u0430\u0436\u044B
    \u0456\u0445, \u043A\u0430\u0431 \u0437\u0430\u0431\u0440\u0430\u0446\u044C \u0443\u0437\u043D\u0430\u0433\u0430\u0440\u043E\u0434\u0443."
  - "\u0413\u044D\u0442\u044B \u043A\u043B\u044E\u0447 \u0430\u0434\u043A\u0440\u044B\u0432\u0430\u0435
    \u0437\u0430\u043C\u043A\u043D\u0451\u043D\u044B \u043A\u0443\u0444\u0430\u0440."
  - "\u041A\u0443\u043F\u0430\u043B \u043D\u0435 \u043F\u0443\u0441\u043A\u0430\u0435
    \u043C\u043E\u043D\u0441\u0442\u0440\u0430\u045E \u0456 \u043B\u0435\u0447\u044B\u0446\u044C.
    \u041F\u0430\u0434\u0447\u0430\u0441 \u0445\u0432\u0430\u043B\u0456 \u0447\u0430\u0441
    \u0443\u043D\u0443\u0442\u0440\u044B \u0430\u0431\u043C\u0435\u0436\u0430\u0432\u0430\u043D\u044B."
  - "\u0421\u0442\u0440\u044D\u043B\u044C \u0443 \u0431\u043E\u0447\u043A\u0443,
    \u043A\u0430\u0431 \u0432\u044B\u043A\u043B\u0456\u043A\u0430\u0446\u044C \u044F\u0435
    \u044D\u0444\u0435\u043A\u0442. \u0422\u0440\u044B\u043C\u0430\u0439\u0441\u044F
    \u0434\u0430\u043B\u0435\u0439, \u043A\u0430\u043B\u0456 \u044F\u043D\u0430 \u0432\u044B\u0431\u0443\u0445\u043D\u0435."
  - "\u0421\u044F\u0434\u0430\u0439 \u0443 \u043C\u0430\u0448\u044B\u043D\u0443,
    \u043A\u0430\u0431 \u0442\u0430\u0440\u0430\u043D\u0456\u0446\u044C \u043C\u043E\u043D\u0441\u0442\u0440\u0430\u045E.
    \u0410\u0434 \u043C\u043E\u0446\u043D\u044B\u0445 \u043F\u0430\u0448\u043A\u043E\u0434\u0436\u0430\u043D\u043D\u044F\u045E
    \u044F\u043D\u0430 \u043B\u0430\u043C\u0430\u0435\u0446\u0446\u0430."
  - "\u0411\u043E\u0441 \u043F\u0430\u043F\u044F\u0440\u044D\u0434\u0436\u0432\u0430\u0435
    \u043F\u0440\u0430 \u0430\u0442\u0430\u043A\u0456. \u0412\u044B\u0439\u0434\u0437\u0456
    \u0437 \u043F\u0430\u0437\u043D\u0430\u0447\u0430\u043D\u0430\u0439 \u0437\u043E\u043D\u044B
    \u0434\u0430 \u045E\u0434\u0430\u0440\u0443."
  - "\u0410\u0440\u044D\u043D\u0430 \u0437\u0430\u043C\u043A\u043D\u0451\u043D\u0430\u044F
    \u0434\u0430 \u043F\u0435\u0440\u0430\u043C\u043E\u0433\u0456 \u043D\u0430\u0434
    \u0431\u043E\u0441\u0430\u043C. \u041F\u0435\u0440\u0430\u043C\u043E\u0433\u0430
    \u0437 \u0437\u0430\u043C\u043A\u043D\u0451\u043D\u0430\u0439 \u0430\u0440\u044D\u043D\u0430\u0439
    \u0434\u0430\u0435 \u0431\u043E\u043D\u0443\u0441."
  - "\u0421\u0442\u0430\u043D\u044C \u043D\u0430 \u043B\u0435\u0441\u0432\u0456\u0446\u0443,
    \u043A\u0430\u0431 \u043F\u0435\u0440\u0430\u0439\u0441\u0446\u0456 \u043D\u0430
    \u0456\u043D\u0448\u044B \u043F\u0430\u0432\u0435\u0440\u0445. \u041C\u043E\u043D\u0441\u0442\u0440\u044B
    \u043C\u043E\u0433\u0443\u0446\u044C \u043F\u0430\u0439\u0441\u0446\u0456 \u0441\u043B\u0435\u0434\u0430\u043C."
  - "\u0413\u0430\u0440\u0433\u0443\u043B\u043B\u044F"
  - "\u0412\u044B\u0439\u0434\u0437\u0456\u0446\u0435 \u0437 \u0446\u0435\u043D\u044E
    \u0434\u0430 \u0442\u0430\u0433\u043E, \u044F\u043A \u0433\u0430\u0440\u0433\u0443\u043B\u043B\u044F
    \u0441\u043F\u0456\u043A\u0456\u0440\u0443\u0435. \u041A\u0430\u043C\u0435\u043D\u043D\u0430\u044F
    \u0441\u043A\u0443\u0440\u0430 \u043D\u0435\u043A\u0430\u043B\u044C\u043A\u0456
    \u0441\u0435\u043A\u0443\u043D\u0434 \u043F\u0430\u0433\u043B\u044B\u043D\u0430\u0435
    \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0447\u0430\u0441\u0442\u043A\u0443
    \u045E\u0440\u043E\u043D\u0443."
  - "\u0426\u0456\u0445\u0430\u0435 \u043F\u0430\u043B\u044F\u0432\u0430\u043D\u043D\u0435"
  - "\u0420\u0430\u0434\u044B\u0443\u0441 \u0448\u0443\u043C\u0443 \u0441\u0442\u0440\u044D\u043B\u0430\u045E
    \u221240%."
  - "\u0410\u043F\u043E\u0448\u043D\u0456 \u043F\u0430\u0442\u0440\u043E\u043D"
  - "\u0410\u043F\u043E\u0448\u043D\u0456 \u0441\u0442\u0440\u044D\u043B \u0443 \u043C\u0430\u0433\u0430\u0437\u0456\u043D\u0435:
    +50% \u0448\u043A\u043E\u0434\u044B (+15% \u0434\u043B\u044F \u0430\u0434\u043D\u0430\u0437\u0430\u0440\u0430\u0434\u043D\u0430\u0439
    \u0437\u0431\u0440\u043E\u0456)."
  - "\u041B\u0430\u043D\u0446\u0443\u0433\u043E\u0432\u0430\u044F \u0440\u044D\u0430\u043A\u0446\u044B\u044F"
  - "\u0417\u0430\u0431\u043E\u0439\u0441\u0442\u0432\u0430 \u0432\u044B\u0431\u0443\u0445\u0430\u043C
    \u043D\u0430\u043D\u043E\u0441\u0456\u0446\u044C 40 \u0448\u043A\u043E\u0434\u044B
    \u043D\u0430\u0439\u0431\u043B\u0456\u0436\u044D\u0439\u0448\u0430\u0439 \u043F\u0430\u0447\u0432\u0430\u0440\u044B
    \u045E \u043C\u0435\u0436\u0430\u0445 2 \u043C. \u0410\u0434\u0437\u0456\u043D
    \u0440\u0430\u0437 \u0437\u0430 \u0432\u044B\u0431\u0443\u0445."
  - "\u041F\u0440\u0430\u043A\u043B\u044F\u0442\u044B\u044F"
  - "\u0417\u0431\u0440\u043E\u044F \u043F\u0430\u0437\u043D\u0430\u0447\u0430\u0435
    \u0446\u044D\u043B\u044C \u043D\u0430 4 \u0441. \u041D\u0430\u0441\u0442\u0443\u043F\u043D\u044B\u044F
    \u0442\u0440\u0430\u043F\u043B\u0435\u043D\u043D\u0456 \u043F\u0430 \u043F\u0430\u0437\u043D\u0430\u0446\u044B
    \u043D\u0430\u043D\u043E\u0441\u044F\u0446\u044C +15% \u0448\u043A\u043E\u0434\u044B."
  - "\u0425\u0430\u043B\u043E\u0434\u043D\u0430\u044F \u0433\u0430\u043B\u0430\u0432\u0430"
  - "\u041F\u0440\u0430\u0437 3 \u0441 \u0431\u0435\u0437 \u0448\u043A\u043E\u0434\u044B
    \u0448\u0430\u043D\u0435\u0446 \u043A\u0440\u044B\u0442\u0443 \u0440\u0430\u0441\u0446\u0435
    \u043D\u0430 10 \u043F. \u043F. \u0434\u0430 \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0430\u0433\u0430
    \u0440\u0430\u043D\u0435\u043D\u043D\u044F."
  - "\u0423\u0446\u044F\u043A\u0430\u0447"
  - "\u041F\u0430\u0441\u043B\u044F \u0440\u0430\u043D\u0435\u043D\u043D\u044F \u0445\u0443\u0442\u043A\u0430\u0441\u0446\u044C
    +25% \u043D\u0430 2 \u0441. \u041F\u0435\u0440\u0430\u0437\u0430\u0440\u0430\u0434\u043A\u0430
    8 \u0441."
  - "\u041B\u044E\u0442\u0430\u0441\u0446\u044C"
