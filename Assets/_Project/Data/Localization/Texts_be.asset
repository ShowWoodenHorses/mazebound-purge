  - "\u0420\u044D\u043A\u043B\u0430\u043C\u0430 \u0437\u0430\u0440\u0430\u0437 \u043D\u0435\u0434\u0430\u0441\u0442\u0443\u043F\u043D\u0430\u044F"
  - "\u041F\u0430\u0432\u044F\u0440\u043D\u0456\u0446\u0435 \u043F\u0440\u044B\u043B\u0430\u0434\u0443"
  - "\u0417\u0420\u0410\u0417\u0423\u041C\u0415\u041B\u0410"
  - "\u0421\u0430\u0440\u0434\u044D\u0447\u043D\u0430 \u0437\u0430\u043F\u0440\u0430\u0448\u0430\u0435\u043C
    \u0443 \u043B\u0430\u0431\u0456\u0440\u044B\u043D\u0442! \u0412\u0430\u0448\u0430
    \u043C\u044D\u0442\u0430 \u2014 \u0437\u043D\u0430\u0439\u0441\u0446\u0456 \u0432\u044B\u0445\u0430\u0434.\n\u0420\u0443\u0445\u0430\u0439\u0446\u0435\u0441\u044F
    \u043A\u043B\u0430\u0432\u0456\u0448\u0430\u043C\u0456 WASD \u0430\u0431\u043E
    \u0441\u0442\u0440\u044D\u043B\u043A\u0430\u043C\u0456 \u0456 \u0456\u0434\u0437\u0456\u0446\u0435
    \u043F\u0430 \u043B\u0456\u043D\u0456\u0456, \u0448\u0442\u043E \u0441\u0432\u0435\u0446\u0456\u0446\u0446\u0430."
  - "\u0421\u0430\u0440\u0434\u044D\u0447\u043D\u0430 \u0437\u0430\u043F\u0440\u0430\u0448\u0430\u0435\u043C
    \u0443 \u043B\u0430\u0431\u0456\u0440\u044B\u043D\u0442! \u0412\u0430\u0448\u0430
    \u043C\u044D\u0442\u0430 \u2014 \u0437\u043D\u0430\u0439\u0441\u0446\u0456 \u0432\u044B\u0445\u0430\u0434.\n\u0420\u0443\u0445\u0430\u0439\u0446\u0435\u0441\u044F
    \u0441\u0442\u044B\u043A\u0430\u043C \u0437\u043B\u0435\u0432\u0430 \u0456 \u0456\u0434\u0437\u0456\u0446\u0435
    \u043F\u0430 \u043B\u0456\u043D\u0456\u0456, \u0448\u0442\u043E \u0441\u0432\u0435\u0446\u0456\u0446\u0446\u0430."
  - "\u0406\u0434\u0437\u0456\u0446\u0435 \u043F\u0430 \u043B\u0456\u043D\u0456\u0456"
  - "\u041D\u0435\u043A\u0430\u0442\u043E\u0440\u044B\u044F \u0434\u0437\u0432\u0435\u0440\u044B
    \u0437\u0430\u043C\u043A\u043D\u0451\u043D\u044B\u044F. \u041A\u043B\u044E\u0447
    \u0430\u0434\u043C\u044B\u043A\u0430\u0435 \u0430\u0434\u043D\u044B \u0434\u0437\u0432\u0435\u0440\u044B
    \u0441\u0432\u0430\u0439\u0433\u043E \u043A\u043E\u043B\u0435\u0440\u0443.\n\u041A\u0430\u0431
    \u043F\u0430\u0434\u0430\u0431\u0440\u0430\u0446\u044C \u043A\u043B\u044E\u0447,
    \u043F\u0440\u043E\u0441\u0442\u0430 \u043D\u0430\u0441\u0442\u0443\u043F\u0456\u0446\u0435
    \u043D\u0430 \u044F\u0433\u043E."
  - "\u041F\u0430\u0434\u0431\u044F\u0440\u044B\u0446\u0435 \u043A\u043B\u044E\u0447"
  - "\u041F\u0430\u0434\u044B\u0434\u0437\u0456\u0446\u0435 \u0434\u0430 \u0434\u0437\u0432\u044F\u0440\u044D\u0439
    \u043A\u043E\u043B\u0435\u0440\u0443 \u043A\u043B\u044E\u0447\u0430 \u0456 \u043D\u0430\u0446\u0456\u0441\u043D\u0456\u0446\u0435
    E, \u043A\u0430\u0431 \u0430\u0434\u0430\u043C\u043A\u043D\u0443\u0446\u044C
    \u0456\u0445. \u041A\u043B\u044E\u0447 \u043F\u0440\u044B \u0433\u044D\u0442\u044B\u043C
    \u043C\u0430\u0440\u043D\u0443\u0435\u0446\u0446\u0430."
  - "\u041F\u0430\u0434\u044B\u0434\u0437\u0456\u0446\u0435 \u0434\u0430 \u0434\u0437\u0432\u044F\u0440\u044D\u0439
    \u043A\u043E\u043B\u0435\u0440\u0443 \u043A\u043B\u044E\u0447\u0430 \u0456 \u043D\u0430\u0446\u0456\u0441\u043D\u0456\u0446\u0435
    \xAB\u0414\u0437\u0435\u044F\u043D\u043D\u0435\xBB (\u043A\u0440\u0443\u0433\u043B\u0430\u044F
    \u043A\u043D\u043E\u043F\u043A\u0430), \u043A\u0430\u0431 \u0430\u0434\u0430\u043C\u043A\u043D\u0443\u0446\u044C
    \u0456\u0445. \u041A\u043B\u044E\u0447 \u043F\u0440\u044B \u0433\u044D\u0442\u044B\u043C
    \u043C\u0430\u0440\u043D\u0443\u0435\u0446\u0446\u0430."
  - "\u0410\u0434\u0430\u043C\u043A\u043D\u0456\u0446\u0435 \u0434\u0437\u0432\u0435\u0440\u044B:
    E"
  - "\u0410\u0434\u0430\u043C\u043A\u043D\u0456\u0446\u0435 \u0434\u0437\u0432\u0435\u0440\u044B:
    \xAB\u0414\u0437\u0435\u044F\u043D\u043D\u0435\xBB"
  - "\u0414\u0437\u0432\u0435\u0440\u044B \u0430\u0434\u0430\u043C\u043A\u043D\u0451\u043D\u044B\u044F,
    \u0430\u043B\u0435 \u044F\u0448\u0447\u044D \u0437\u0430\u0447\u044B\u043D\u0435\u043D\u044B\u044F.
    \u041D\u0430\u0446\u0456\u0441\u043D\u0456\u0446\u0435 E \u044F\u0448\u0447\u044D
    \u0440\u0430\u0437, \u043A\u0430\u0431 \u0430\u0434\u0447\u044B\u043D\u0456\u0446\u044C
    \u0456\u0445. \u0414\u0437\u0432\u0435\u0440\u044B \u043C\u043E\u0436\u043D\u0430
    \u0430\u0434\u0447\u044B\u043D\u044F\u0446\u044C \u0456 \u0437\u0430\u0447\u044B\u043D\u044F\u0446\u044C
    \u043A\u043E\u043B\u044C\u043A\u0456 \u0437\u0430\u045E\u0433\u043E\u0434\u043D\u0430."
  - "\u0414\u0437\u0432\u0435\u0440\u044B \u0430\u0434\u0430\u043C\u043A\u043D\u0451\u043D\u044B\u044F,
    \u0430\u043B\u0435 \u044F\u0448\u0447\u044D \u0437\u0430\u0447\u044B\u043D\u0435\u043D\u044B\u044F.
    \u041D\u0430\u0446\u0456\u0441\u043D\u0456\u0446\u0435 \xAB\u0414\u0437\u0435\u044F\u043D\u043D\u0435\xBB
    \u044F\u0448\u0447\u044D \u0440\u0430\u0437, \u043A\u0430\u0431 \u0430\u0434\u0447\u044B\u043D\u0456\u0446\u044C
    \u0456\u0445. \u0414\u0437\u0432\u0435\u0440\u044B \u043C\u043E\u0436\u043D\u0430
    \u0430\u0434\u0447\u044B\u043D\u044F\u0446\u044C \u0456 \u0437\u0430\u0447\u044B\u043D\u044F\u0446\u044C
    \u043A\u043E\u043B\u044C\u043A\u0456 \u0437\u0430\u045E\u0433\u043E\u0434\u043D\u0430."
  - "\u0410\u0434\u0447\u044B\u043D\u0456\u0446\u0435 \u0434\u0437\u0432\u0435\u0440\u044B:
    E"
  - "\u0410\u0434\u0447\u044B\u043D\u0456\u0446\u0435 \u0434\u0437\u0432\u0435\u0440\u044B:
    \xAB\u0414\u0437\u0435\u044F\u043D\u043D\u0435\xBB"
  - "\u0417\u0431\u0440\u043E\u044F \u043B\u044F\u0436\u044B\u0446\u044C \u043D\u0430
    \u043F\u0430\u0434\u043B\u043E\u0437\u0435. \u0421\u0442\u0430\u043D\u044C\u0446\u0435
    \u043D\u0430 \u044F\u0435 \u0456 \u043D\u0430\u0446\u0456\u0441\u043D\u0456\u0446\u0435
    E, \u043A\u0430\u0431 \u0443\u0437\u044F\u0446\u044C.\n\u041C\u043E\u0436\u043D\u0430
    \u043D\u0430\u0441\u0456\u0446\u044C \u0430\u0434\u043D\u0443 \u0437\u0431\u0440\u043E\u044E
    \u0431\u043B\u0456\u0437\u043A\u0430\u0433\u0430 \u0431\u043E\u044E \u0456 \u0430\u0434\u043D\u0443
    \u0430\u0433\u043D\u044F\u0441\u0442\u0440\u044D\u043B\u044C\u043D\u0443\u044E."
  - "\u0417\u0431\u0440\u043E\u044F \u043B\u044F\u0436\u044B\u0446\u044C \u043D\u0430
    \u043F\u0430\u0434\u043B\u043E\u0437\u0435. \u0421\u0442\u0430\u043D\u044C\u0446\u0435
    \u043D\u0430 \u044F\u0435 \u0456 \u043D\u0430\u0446\u0456\u0441\u043D\u0456\u0446\u0435
    \xAB\u0414\u0437\u0435\u044F\u043D\u043D\u0435\xBB, \u043A\u0430\u0431 \u0443\u0437\u044F\u0446\u044C.\n\u041C\u043E\u0436\u043D\u0430
    \u043D\u0430\u0441\u0456\u0446\u044C \u0430\u0434\u043D\u0443 \u0437\u0431\u0440\u043E\u044E
    \u0431\u043B\u0456\u0437\u043A\u0430\u0433\u0430 \u0431\u043E\u044E \u0456 \u0430\u0434\u043D\u0443
    \u0430\u0433\u043D\u044F\u0441\u0442\u0440\u044D\u043B\u044C\u043D\u0443\u044E."
  - "\u0412\u0430\u0437\u044C\u043C\u0456\u0446\u0435 \u0437\u0431\u0440\u043E\u044E:
    E"
  - "\u0412\u0430\u0437\u044C\u043C\u0456\u0446\u0435 \u0437\u0431\u0440\u043E\u044E:
    \xAB\u0414\u0437\u0435\u044F\u043D\u043D\u0435\xBB"
  - "\u0417\u0430 \u0433\u044D\u0442\u044B\u043C\u0456 \u0434\u0437\u0432\u044F\u0440\u044B\u043C\u0430
    \u0437\u043E\u043C\u0431\u0456! \u0416\u043E\u045E\u0442\u044B \u043A\u043E\u043D\u0443\u0441
    \u2014 \u0442\u043E\u0435, \u0448\u0442\u043E \u0451\u043D \u0431\u0430\u0447\u044B\u0446\u044C:
    \u0442\u0440\u0430\u043F\u0456\u0446\u0435 \u045E \u044F\u0433\u043E \u2014 \u0437\u043E\u043C\u0431\u0456
    \u0437\u0430\u0440\u043E\u045E \u0456 \u043D\u0430\u043F\u0430\u0434\u0437\u0435.\n\u0410\u0434\u0447\u044B\u043D\u0456\u0446\u0435
    \u0434\u0437\u0432\u0435\u0440\u044B \u0456 \u0431\u0456\u0446\u0435 \u044F\u0433\u043E
    \u043F\u0440\u0430\u0431\u0435\u043B\u0430\u043C \u0430\u0431\u043E \u043B\u0435\u0432\u0430\u0439
    \u043A\u043D\u043E\u043F\u043A\u0430\u0439 \u043C\u044B\u0448\u044B."
  - "\u0417\u0430 \u0433\u044D\u0442\u044B\u043C\u0456 \u0434\u0437\u0432\u044F\u0440\u044B\u043C\u0430
    \u0437\u043E\u043C\u0431\u0456! \u0416\u043E\u045E\u0442\u044B \u043A\u043E\u043D\u0443\u0441
    \u2014 \u0442\u043E\u0435, \u0448\u0442\u043E \u0451\u043D \u0431\u0430\u0447\u044B\u0446\u044C:
    \u0442\u0440\u0430\u043F\u0456\u0446\u0435 \u045E \u044F\u0433\u043E \u2014 \u0437\u043E\u043C\u0431\u0456
    \u0437\u0430\u0440\u043E\u045E \u0456 \u043D\u0430\u043F\u0430\u0434\u0437\u0435.\n\u0410\u0434\u0447\u044B\u043D\u0456\u0446\u0435
    \u0434\u0437\u0432\u0435\u0440\u044B \u0456 \u0431\u0456\u0446\u0435 \u044F\u0433\u043E
    \u0432\u044F\u043B\u0456\u043A\u0430\u0439 \u043A\u043D\u043E\u043F\u043A\u0430\u0439
    \u0430\u0442\u0430\u043A\u0456 \u0441\u043F\u0440\u0430\u0432\u0430."
  - "\u041F\u0435\u0440\u0430\u043C\u0430\u0436\u044B\u0446\u0435 \u0437\u043E\u043C\u0431\u0456:
    \u043F\u0440\u0430\u0431\u0435\u043B / \u043B\u0435\u0432\u0430\u044F \u043A\u043D\u043E\u043F\u043A\u0430
    \u043C\u044B\u0448\u044B"
  - "\u041F\u0435\u0440\u0430\u043C\u0430\u0436\u044B\u0446\u0435 \u0437\u043E\u043C\u0431\u0456:
    \u043A\u043D\u043E\u043F\u043A\u0430 \u0430\u0442\u0430\u043A\u0456"
  - "\u0410\u0433\u043D\u044F\u0441\u0442\u0440\u044D\u043B\u044C\u043D\u0430\u044F
    \u0437\u0431\u0440\u043E\u044F! \u042F\u043D\u0430 \u0431\u2019\u0435 \u0437\u0434\u0430\u043B\u0451\u043A\u0443,
    \u0430\u043B\u0435 \u043C\u0430\u0433\u0430\u0437\u0456\u043D \u043D\u0435\u0432\u044F\u043B\u0456\u043A\u0456:
    \u043F\u0435\u0440\u0430\u0437\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430
    \u0441\u0430\u043C\u0430, \u043A\u0430\u043B\u0456 \u043F\u0443\u0441\u0442\u044B,
    \u0430\u0431\u043E \u043D\u0430\u0446\u0456\u0441\u043D\u0456\u0446\u0435 R.\n\u0417\u043C\u044F\u043D\u044F\u0439\u0446\u0435
    \u0437\u0431\u0440\u043E\u044E \u043A\u043B\u0430\u0432\u0456\u0448\u0430\u043C\u0456
    1 \u0456 2."
  - "\u0410\u0433\u043D\u044F\u0441\u0442\u0440\u044D\u043B\u044C\u043D\u0430\u044F
    \u0437\u0431\u0440\u043E\u044F! \u042F\u043D\u0430 \u0431\u2019\u0435 \u0437\u0434\u0430\u043B\u0451\u043A\u0443,
    \u0430\u043B\u0435 \u043C\u0430\u0433\u0430\u0437\u0456\u043D \u043D\u0435\u0432\u044F\u043B\u0456\u043A\u0456:
    \u043F\u0435\u0440\u0430\u0437\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430
    \u0441\u0430\u043C\u0430, \u043A\u0430\u043B\u0456 \u043F\u0443\u0441\u0442\u044B,
    \u0430\u0431\u043E \u043D\u0430\u0446\u0456\u0441\u043D\u0456\u0446\u0435 \u043D\u0430
    \u044F\u0435 \u0441\u043B\u043E\u0442 \u044F\u0448\u0447\u044D \u0440\u0430\u0437.\n\u0417\u043C\u044F\u043D\u044F\u0439\u0446\u0435
