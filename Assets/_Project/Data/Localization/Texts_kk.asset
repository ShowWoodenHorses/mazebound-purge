    \u0436\u043E\u043B\u0434\u044B \u043A\u04E9\u0440\u0441\u0435\u0442\u0435\u0434\u0456."
  - "\u041A\u0430\u0440\u0442\u0430\u043D\u044B \u0430\u0448\u044B\u04A3\u044B\u0437:
    M"
  - "\u041A\u0430\u0440\u0442\u0430\u043D\u044B \u0430\u0448\u044B\u04A3\u044B\u0437"
  - "\u0415\u043D\u0434\u0456 \u0448\u044B\u0493\u0443\u0493\u0430 \u2014 \u0431\u0430\u0441\u043F\u0430\u043B\u0434\u0430\u049B\u049B\u0430
    \u0431\u0430\u0440\u044B\u04A3\u044B\u0437.\n\u0414\u0435\u04A3\u0433\u0435\u0439\u043B\u0435\u0440\u0434\u0435
    \u0436\u04B1\u043B\u0434\u044B\u0437\u0434\u0430\u0440 \u0430\u043B\u0430\u0441\u044B\u0437:
    \u0431\u0456\u0440\u0435\u0443\u0456 \u0448\u044B\u0493\u0443 \u04AF\u0448\u0456\u043D,
    \u0431\u0456\u0440\u0435\u0443\u0456 \u0431\u0430\u0440\u043B\u044B\u049B \u0437\u043E\u043C\u0431\u0438\u0434\u0456
    \u0436\u043E\u0439\u0493\u0430\u043D\u044B\u04A3\u044B\u0437 \u04AF\u0448\u0456\u043D
    \u0436\u04D9\u043D\u0435 \u0431\u0456\u0440\u0435\u0443\u0456 \u0431\u0430\u0440\u043B\u044B\u049B
    \u043A\u0430\u0440\u0442\u0430 \u0431\u04E9\u043B\u0456\u043A\u0442\u0435\u0440\u0456
    \u04AF\u0448\u0456\u043D."
  - "\u0428\u044B\u0493\u0443\u0493\u0430 \u0431\u0430\u0440\u044B\u04A3\u044B\u0437"
