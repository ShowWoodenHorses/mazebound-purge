    \u0442\u04AF\u0439\u043C\u0435\u0441\u0456\u043D \u0431\u0430\u0441\u044B\u04A3\u044B\u0437."
  - "\u0410\u043B\u044B\u0441\u0442\u0430\u043D \u0430\u0442\u0430\u0442\u044B\u043D
    \u043E\u0444\u0438\u0446\u0435\u0440\u0434\u0456 \u0431\u0430\u049B\u044B\u043B\u0430\u04A3\u044B\u0437.
    \u0415\u0441\u043A\u0435\u0440\u0442\u0443 \u0448\u044B\u049B\u049B\u0430\u043D\u0434\u0430
    \u0430\u0442\u044B\u0441 \u0448\u0435\u0431\u0456\u043D\u0435\u043D \u0448\u044B\u0493\u044B\u04A3\u044B\u0437.
    \u041D\u04D9\u0442\u0438\u0436\u0435\u043D\u0456 \u043A\u04E9\u0440\u0443 \u04AF\u0448\u0456\u043D
    \u0442\u043E\u043B\u049B\u044B\u043D\u0434\u044B \u0430\u044F\u049B\u0442\u0430\u04A3\u044B\u0437."
  - "\u0411\u0435\u043B\u0433\u0456\u0433\u0435 \u0436\u0435\u0442\u0456\u04A3\u0456\u0437"
  - "\u0410\u0442\u0443 \u04AF\u0448\u0456\u043D \u043E\u04A3 \u0436\u0430\u049B
    \u0441\u0442\u0438\u043A\u0442\u0456 \u0431\u0430\u0493\u044B\u0442\u0442\u0430\u04A3\u044B\u0437
    \u043D\u0435\u043C\u0435\u0441\u0435 \u0431\u0456\u0440 \u0441\u0442\u0438\u043A
    \u0440\u0435\u0436\u0438\u043C\u0456\u043D\u0434\u0435 \u0448\u0430\u0431\u0443\u044B\u043B
    \u0442\u04AF\u0439\u043C\u0435\u0441\u0456\u043D \u0431\u0430\u0441\u044B\u04A3\u044B\u0437."
  - "\u0411\u0435\u043B\u0433\u0456\u043B\u0435\u043D\u0433\u0435\u043D \u049B\u0430\u0440\u0443\u0493\u0430
    \u0436\u0430\u049B\u044B\u043D\u0434\u0430\u043F, \u04D9\u0440\u0435\u043A\u0435\u0442
    \u0442\u04AF\u0439\u043C\u0435\u0441\u0456\u043D \u0431\u0430\u0441\u044B\u04A3\u044B\u0437."
  - "\u0411\u0430\u0441\u049B\u0430 \u049B\u0430\u0440\u0443 \u04B1\u044F\u0448\u044B\u0493\u044B\u043D
    \u0431\u0430\u0441\u044B\u04A3\u044B\u0437."
  - "\u0413\u0440\u0430\u043D\u0430\u0442\u0430 \u0442\u04AF\u0439\u043C\u0435\u0441\u0456\u043D
    \u0431\u0430\u0441\u044B\u043F, \u043B\u0430\u049B\u0442\u044B\u0440\u0443 \u043D\u04AF\u043A\u0442\u0435\u0441\u0456\u043D
    \u0442\u04AF\u0440\u0442\u0456\u04A3\u0456\u0437. \u041B\u0430\u049B\u0442\u044B\u0440\u0493\u0430\u043D
    \u0441\u043E\u04A3 \u0431\u0456\u0440\u0456\u043D\u0448\u0456 \u0442\u043E\u043B\u049B\u044B\u043D
    \u0431\u0430\u0441\u0442\u0430\u043B\u0430\u0434\u044B."
  - "\u041E\u0439\u044B\u043D \u043A\u0435\u04A3\u0435\u0441\u0442\u0435\u0440\u0456"
  - "\u0411\u0456\u0440\u0456\u043D\u0448\u0456 \u0434\u0435\u04A3\u0433\u0435\u0439\u0434\u0456
    \u0431\u0430\u0441\u0442\u0430\u0443 \u04AF\u0448\u0456\u043D Desert \u0441\u0430\u0442\u044B\u043F
    \u0430\u043B."
  - "\u041A\u0415\u04A2\u0415\u0421"
  - "\u0414\u044B\u0431\u044B\u0441 \u0431\u04D9\u0441\u0435\u04A3\u0434\u0435\u0442\u043A\u0456\u0448
    \u0430\u0442\u044B\u0441 \u04AF\u043D\u0456\u043D \u0430\u0437\u0430\u0439\u0442\u0430\u0434\u044B,
    \u0441\u043E\u043D\u0434\u044B\u049B\u0442\u0430\u043D \u0441\u0435\u043D\u0456
    \u0430\u0437 \u049B\u04B1\u0431\u044B\u0436\u044B\u049B \u0435\u0441\u0442\u0438\u0434\u0456."
  - "\u0410\u043B\u044B\u0441\u0442\u0430\u043D \u0430\u0442\u0430\u0442\u044B\u043D
    \u043E\u0444\u0438\u0446\u0435\u0440 \u049B\u0430\u0448\u044B\u049B\u0442\u0430\u043D
    \u0448\u0430\u0431\u0443\u044B\u043B\u0434\u0430\u0439\u0434\u044B. \u0421\u043E\u049B\u049B\u044B\u0493\u0430
    \u0434\u0435\u0439\u0456\u043D \u0431\u0435\u043B\u0433\u0456\u043B\u0435\u043D\u0433\u0435\u043D
    \u0430\u0439\u043C\u0430\u049B\u0442\u0430\u043D \u0448\u044B\u049B."
  - "\u0411\u0430\u049B\u0441\u044B \u049B\u04B1\u043B\u0430\u0493\u0430\u043D \u049B\u04B1\u0431\u044B\u0436\u044B\u049B\u0442\u0430\u0440\u0434\u044B
    \u0442\u0456\u0440\u0456\u043B\u0442\u0435\u0434\u0456. \u041A\u04E9\u043C\u0435\u043A\u0442\u0456
    \u0442\u043E\u049B\u0442\u0430\u0442\u0443 \u04AF\u0448\u0456\u043D \u0431\u0430\u049B\u0441\u044B\u043D\u044B
    \u0436\u0435\u04A3."
  - "\u0421\u0430\u0443\u044B\u0442\u0442\u044B \u0436\u0430\u0443 \u0430\u043B\u0434\u044B\u043D\u0430\u043D
    \u0430\u0437 \u0437\u0430\u049B\u044B\u043C \u0430\u043B\u0430\u0434\u044B. \u0411\u04AF\u0439\u0456\u0440\u0456\u043D\u0435\u043D
    \u043D\u0435 \u0430\u0440\u0442\u044B\u043D\u0430\u043D \u0430\u0442."
  - "\u0427\u0435\u043C\u043F\u0438\u043E\u043D\u0434\u0430\u0440\u0434\u044B\u04A3
    \u0435\u0440\u0435\u043A\u0448\u0435 \u049B\u0430\u0441\u0438\u0435\u0442\u0442\u0435\u0440\u0456
    \u043E\u043B\u0430\u0440\u0434\u044B \u049B\u0430\u0442\u0430\u0440\u0434\u0430\u0493\u044B
    \u049B\u04B1\u0431\u044B\u0436\u044B\u049B\u0442\u0430\u0440\u0434\u0430\u043D
    \u049B\u0430\u0443\u0456\u043F\u0442\u0456 \u0435\u0442\u0435\u0434\u0456."
  - "\u0406\u043B\u043C\u0435\u043A \u0441\u0435\u043D\u0456 \u04E9\u0437\u0456\u043D\u0435
    \u0442\u0430\u0440\u0442\u0430 \u0430\u043B\u0430\u0434\u044B. \u041E\u043B \u0448\u0430\u0431\u0443\u044B\u043B\u0493\u0430
    \u0434\u0430\u0439\u044B\u043D\u0434\u0430\u043B\u0493\u0430\u043D\u0434\u0430
    \u0448\u0435\u0442\u043A\u0435 \u0448\u044B\u049B."
  - "\u041E\u043B\u0436\u0430\u043D\u044B \u0430\u043B\u0443 \u04AF\u0448\u0456\u043D
    \u043A\u04D9\u0434\u0456\u043C\u0433\u0456 \u0441\u0430\u043D\u0434\u044B\u049B\u0442\u044B
    \u0430\u0448."
  - "\u049A\u04B1\u043B\u044B\u043F\u0442\u0430\u043B\u0493\u0430\u043D \u0441\u0430\u043D\u0434\u044B\u049B\u049B\u0430
    \u043A\u0456\u043B\u0442 \u043A\u0435\u0440\u0435\u043A. \u0406\u0448\u0456\u043D\u0434\u0435
    \u0441\u0438\u0440\u0435\u0433\u0456\u0440\u0435\u043A \u049B\u0430\u0440\u0443
    \u0431\u0430\u0440."
  - "\u0411\u04B1\u043B \u0441\u0430\u043D\u0434\u044B\u049B \u0447\u0435\u043C\u043F\u0438\u043E\u043D\u0434\u0430\u0440\u0434\u044B
    \u0448\u0430\u049B\u044B\u0440\u0430\u0434\u044B. \u0421\u044B\u0439\u043B\u044B\u049B
    \u04AF\u0448\u0456\u043D \u043E\u043B\u0430\u0440\u0434\u044B \u0436\u0435\u04A3."
  - "\u0411\u04B1\u043B \u043A\u0456\u043B\u0442 \u049B\u04B1\u043B\u044B\u043F\u0442\u0430\u043B\u0493\u0430\u043D
    \u0441\u0430\u043D\u0434\u044B\u049B\u0442\u044B \u0430\u0448\u0430\u0434\u044B."
  - "\u041A\u04AF\u043C\u0431\u0435\u0437 \u049B\u04B1\u0431\u044B\u0436\u044B\u049B\u0442\u0430\u0440\u0434\u044B
    \u04E9\u0442\u043A\u0456\u0437\u0431\u0435\u0439\u0434\u0456 \u0436\u04D9\u043D\u0435
    \u0434\u0435\u043D\u0441\u0430\u0443\u043B\u044B\u049B\u0442\u044B \u049B\u0430\u043B\u043F\u044B\u043D\u0430
    \u043A\u0435\u043B\u0442\u0456\u0440\u0435\u0434\u0456. \u0422\u043E\u043B\u049B\u044B\u043D
    \u043A\u0435\u0437\u0456\u043D\u0434\u0435 \u0456\u0448\u0442\u0435 \u049B\u0430\u043B\u0443
    \u0443\u0430\u049B\u044B\u0442\u044B \u0448\u0435\u043A\u0442\u0435\u0443\u043B\u0456."
  - "\u04D8\u0441\u0435\u0440\u0456\u043D \u0456\u0441\u043A\u0435 \u049B\u043E\u0441\u0443
    \u04AF\u0448\u0456\u043D \u0431\u04E9\u0448\u043A\u0435\u0433\u0435 \u0430\u0442.
    \u0416\u0430\u0440\u044B\u043B\u0493\u0430\u043D\u0434\u0430 \u0430\u043B\u044B\u0441
    \u0442\u04B1\u0440."
  - "\u049A\u04B1\u0431\u044B\u0436\u044B\u049B\u0442\u0430\u0440\u0434\u044B \u0441\u043E\u0493\u0443
    \u04AF\u0448\u0456\u043D \u043A\u04E9\u043B\u0456\u043A\u043A\u0435 \u043E\u0442\u044B\u0440.
    \u041A\u04E9\u043B\u0456\u043A \u049B\u0430\u0442\u0442\u044B \u0437\u0430\u049B\u044B\u043C\u0434\u0430\u043D\u0441\u0430,
    \u0431\u04B1\u0437\u044B\u043B\u0430\u0434\u044B."
  - "\u0411\u0430\u0441\u0442\u044B\u049B \u0448\u0430\u0431\u0443\u044B\u043B\u044B\u043D
    \u0430\u043B\u0434\u044B\u043D \u0430\u043B\u0430 \u0431\u0456\u043B\u0434\u0456\u0440\u0435\u0434\u0456.
    \u0421\u043E\u049B\u049B\u044B\u0493\u0430 \u0434\u0435\u0439\u0456\u043D \u0431\u0435\u043B\u0433\u0456\u043B\u0435\u043D\u0433\u0435\u043D
    \u0430\u0439\u043C\u0430\u049B\u0442\u0430\u043D \u0448\u044B\u049B."
  - "\u0411\u0430\u0441\u0442\u044B\u049B\u0442\u044B \u0436\u0435\u04A3\u0433\u0435\u043D\u0448\u0435
    \u0430\u0440\u0435\u043D\u0430 \u0436\u0430\u0431\u044B\u049B. \u0416\u0430\u0431\u044B\u049B
    \u0430\u0440\u0435\u043D\u0430\u043C\u0435\u043D \u0434\u0435\u04A3\u0433\u0435\u0439\u0434\u0456
    \u04E9\u0442\u0441\u0435\u04A3, \u049B\u043E\u0441\u044B\u043C\u0448\u0430 \u0441\u044B\u0439\u043B\u044B\u049B
    \u0430\u043B\u0430\u0441\u044B\u04A3."
  - "\u0411\u0430\u0441\u049B\u0430 \u049B\u0430\u0431\u0430\u0442\u049B\u0430 \u04E9\u0442\u0443
    \u04AF\u0448\u0456\u043D \u0431\u0430\u0441\u043F\u0430\u043B\u0434\u0430\u049B\u049B\u0430
    \u0431\u0430\u0441. \u049A\u04B1\u0431\u044B\u0436\u044B\u049B\u0442\u0430\u0440
    \u0430\u0440\u0442\u044B\u04A3\u043D\u0430\u043D \u0435\u0440\u0435 \u0430\u043B\u0430\u0434\u044B."
  - "\u0413\u0430\u0440\u0433\u0443\u043B\u044C\u044F"
  - "\u0413\u0430\u0440\u0433\u0443\u043B\u044C\u044F \u0442\u04E9\u043C\u0435\u043D
    \u049B\u04B1\u043B\u0434\u0438\u043B\u0430\u043C\u0430\u0439 \u0442\u04B1\u0440\u044B\u043F,
    \u043A\u04E9\u043B\u0435\u04A3\u043A\u0435\u0434\u0435\u043D \u0448\u044B\u0493\u044B\u04A3\u044B\u0437.
    \u041E\u043D\u044B\u04A3 \u0442\u0430\u0441 \u0442\u0435\u0440\u0456\u0441\u0456
    \u0431\u0456\u0440\u043D\u0435\u0448\u0435 \u0441\u0435\u043A\u0443\u043D\u0434
    \u0431\u043E\u0439\u044B \u0437\u0430\u049B\u044B\u043C\u043D\u044B\u04A3 \u043A\u04E9\u043F
    \u0431\u04E9\u043B\u0456\u0433\u0456\u043D \u0441\u0456\u04A3\u0456\u0440\u0435\u0434\u0456."
  _missing: []
