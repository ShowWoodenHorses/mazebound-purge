    \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0442\u0456 \u0441\u0430\u049B\u0442\u0430\u0443
    \u04AF\u0448\u0456\u043D \u043A\u0456\u0440\u0456\u04A3\u0456\u0437"
  - "\u04AE\u0419\u0420\u0415\u0422\u0423"
  - "\u04AE\u0419\u0420\u0415\u0422\u0423 \u0410\u042F\u049A\u0422\u0410\u041B\u0414\u042B"
  - "\u04AE\u0439\u0440\u0435\u0442\u0443 \u0431\u0430\u0493\u044B\u0442\u044B"
  - "\u0416\u0430\u0440\u043D\u0430\u043C\u0430 \u049B\u0430\u0437\u0456\u0440 \u049B\u043E\u043B\u0436\u0435\u0442\u0456\u043C\u0441\u0456\u0437"
  - "\u049A\u04B1\u0440\u044B\u043B\u0493\u044B\u043D\u044B \u0431\u04B1\u0440\u044B\u04A3\u044B\u0437"
  - "\u0422\u04AE\u0421\u0406\u041D\u0406\u041A\u0422\u0406"
  - "\u041B\u0430\u0431\u0438\u0440\u0438\u043D\u0442\u043A\u0435 \u049B\u043E\u0448
    \u043A\u0435\u043B\u0434\u0456\u04A3\u0456\u0437! \u0421\u0456\u0437\u0434\u0456\u04A3
    \u043C\u0430\u049B\u0441\u0430\u0442\u044B\u04A3\u044B\u0437 \u2014 \u0448\u044B\u0493\u0443\u0434\u044B
    \u0442\u0430\u0431\u0443.\nWASD \u043D\u0435\u043C\u0435\u0441\u0435 \u043A\u04E9\u0440\u0441\u0435\u0442\u043A\u0456
    \u043F\u0435\u0440\u043D\u0435\u043B\u0435\u0440\u0456\u043C\u0435\u043D \u0436\u04AF\u0440\u0456\u043F,
    \u0436\u0430\u0440\u049B\u044B\u0440\u0430\u0493\u0430\u043D \u0441\u044B\u0437\u044B\u049B\u043F\u0435\u043D
    \u0436\u04AF\u0440\u0456\u04A3\u0456\u0437."
  - "\u041B\u0430\u0431\u0438\u0440\u0438\u043D\u0442\u043A\u0435 \u049B\u043E\u0448
    \u043A\u0435\u043B\u0434\u0456\u04A3\u0456\u0437! \u0421\u0456\u0437\u0434\u0456\u04A3
    \u043C\u0430\u049B\u0441\u0430\u0442\u044B\u04A3\u044B\u0437 \u2014 \u0448\u044B\u0493\u0443\u0434\u044B
    \u0442\u0430\u0431\u0443.\n\u0421\u043E\u043B \u0436\u0430\u049B\u0442\u0430\u0493\u044B
    \u0441\u0442\u0438\u043A\u043F\u0435\u043D \u0436\u04AF\u0440\u0456\u043F, \u0436\u0430\u0440\u049B\u044B\u0440\u0430\u0493\u0430\u043D
    \u0441\u044B\u0437\u044B\u049B\u043F\u0435\u043D \u0436\u04AF\u0440\u0456\u04A3\u0456\u0437."
  - "\u0421\u044B\u0437\u044B\u049B\u043F\u0435\u043D \u0436\u04AF\u0440\u0456\u04A3\u0456\u0437"
  - "\u041A\u0435\u0439\u0431\u0456\u0440 \u0435\u0441\u0456\u043A\u0442\u0435\u0440
    \u049B\u04B1\u043B\u044B\u043F\u0442\u0430\u0443\u043B\u044B. \u041A\u0456\u043B\u0442
    \u04E9\u0437 \u0442\u04AF\u0441\u0456\u043D\u0434\u0435\u0433\u0456 \u0431\u0456\u0440
    \u0435\u0441\u0456\u043A\u0442\u0456 \u0430\u0448\u0430\u0434\u044B.\n\u041A\u0456\u043B\u0442\u0442\u0456
    \u0430\u043B\u0443 \u04AF\u0448\u0456\u043D \u043E\u043D\u044B\u04A3 \u04AF\u0441\u0442\u0456\u043D\u0435
    \u0431\u0430\u0441\u044B\u04A3\u044B\u0437."
  - "\u041A\u0456\u043B\u0442\u0442\u0456 \u0430\u043B\u044B\u04A3\u044B\u0437"
  - "\u041A\u0456\u043B\u0442 \u0442\u04AF\u0441\u0456\u043D\u0434\u0435\u0433\u0456
    \u0435\u0441\u0456\u043A\u043A\u0435 \u0436\u0430\u049B\u044B\u043D\u0434\u0430\u043F,
    \u049B\u04B1\u043B\u043F\u044B\u043D \u0430\u0448\u0443 \u04AF\u0448\u0456\u043D
    E \u0431\u0430\u0441\u044B\u04A3\u044B\u0437. \u041A\u0456\u043B\u0442 \u0436\u04B1\u043C\u0441\u0430\u043B\u0430\u0434\u044B."
  - "\u041A\u0456\u043B\u0442 \u0442\u04AF\u0441\u0456\u043D\u0434\u0435\u0433\u0456
    \u0435\u0441\u0456\u043A\u043A\u0435 \u0436\u0430\u049B\u044B\u043D\u0434\u0430\u043F,
    \u049B\u04B1\u043B\u043F\u044B\u043D \u0430\u0448\u0443 \u04AF\u0448\u0456\u043D
    \xAB\u04D8\u0440\u0435\u043A\u0435\u0442\xBB (\u0434\u04E9\u04A3\u0433\u0435\u043B\u0435\u043A
    \u0431\u0430\u0442\u044B\u0440\u043C\u0430) \u0431\u0430\u0441\u044B\u04A3\u044B\u0437.
    \u041A\u0456\u043B\u0442 \u0436\u04B1\u043C\u0441\u0430\u043B\u0430\u0434\u044B."
  - "\u0415\u0441\u0456\u043A \u049B\u04B1\u043B\u043F\u044B\u043D \u0430\u0448\u044B\u04A3\u044B\u0437:
    E"
  - "\u0415\u0441\u0456\u043A \u049B\u04B1\u043B\u043F\u044B\u043D \u0430\u0448\u044B\u04A3\u044B\u0437:
    \xAB\u04D8\u0440\u0435\u043A\u0435\u0442\xBB"
  - "\u0415\u0441\u0456\u043A \u049B\u04B1\u043B\u043F\u044B \u0430\u0448\u044B\u043B\u0434\u044B,
    \u0431\u0456\u0440\u0430\u049B \u043E\u043B \u04D9\u043B\u0456 \u0436\u0430\u0431\u044B\u049B.
    \u0410\u0448\u0443 \u04AF\u0448\u0456\u043D E-\u043D\u0456 \u0442\u0430\u0493\u044B
    \u0431\u0430\u0441\u044B\u04A3\u044B\u0437. \u0415\u0441\u0456\u043A\u0442\u0435\u0440\u0434\u0456
    \u049B\u0430\u043B\u0430\u0493\u0430\u043D\u044B\u04A3\u044B\u0437\u0448\u0430
    \u0430\u0448\u044B\u043F-\u0436\u0430\u0431\u0443\u0493\u0430 \u0431\u043E\u043B\u0430\u0434\u044B."
  - "\u0415\u0441\u0456\u043A \u049B\u04B1\u043B\u043F\u044B \u0430\u0448\u044B\u043B\u0434\u044B,
    \u0431\u0456\u0440\u0430\u049B \u043E\u043B \u04D9\u043B\u0456 \u0436\u0430\u0431\u044B\u049B.
    \u0410\u0448\u0443 \u04AF\u0448\u0456\u043D \xAB\u04D8\u0440\u0435\u043A\u0435\u0442\xBB
    \u0431\u0430\u0442\u044B\u0440\u043C\u0430\u0441\u044B\u043D \u0442\u0430\u0493\u044B
    \u0431\u0430\u0441\u044B\u04A3\u044B\u0437. \u0415\u0441\u0456\u043A\u0442\u0435\u0440\u0434\u0456
    \u049B\u0430\u043B\u0430\u0493\u0430\u043D\u044B\u04A3\u044B\u0437\u0448\u0430
    \u0430\u0448\u044B\u043F-\u0436\u0430\u0431\u0443\u0493\u0430 \u0431\u043E\u043B\u0430\u0434\u044B."
  - "\u0415\u0441\u0456\u043A\u0442\u0456 \u0430\u0448\u044B\u04A3\u044B\u0437: E"
  - "\u0415\u0441\u0456\u043A\u0442\u0456 \u0430\u0448\u044B\u04A3\u044B\u0437: \xAB\u04D8\u0440\u0435\u043A\u0435\u0442\xBB"
  - "\u049A\u0430\u0440\u0443 \u0435\u0434\u0435\u043D\u0434\u0435 \u0436\u0430\u0442\u044B\u0440.
    \u041E\u043D\u044B\u04A3 \u04AF\u0441\u0442\u0456\u043D\u0435 \u0442\u04B1\u0440\u044B\u043F,
    \u0430\u043B\u0443 \u04AF\u0448\u0456\u043D E \u0431\u0430\u0441\u044B\u04A3\u044B\u0437.\n\u0411\u0456\u0440
    \u0436\u0430\u049B\u044B\u043D \u04B1\u0440\u044B\u0441 \u049B\u0430\u0440\u0443\u044B\u043D
    \u0436\u04D9\u043D\u0435 \u0431\u0456\u0440 \u0430\u0442\u044B\u0441 \u049B\u0430\u0440\u0443\u044B\u043D
    \u0430\u043B\u044B\u043F \u0436\u04AF\u0440\u0443\u0433\u0435 \u0431\u043E\u043B\u0430\u0434\u044B."
  - "\u049A\u0430\u0440\u0443 \u0435\u0434\u0435\u043D\u0434\u0435 \u0436\u0430\u0442\u044B\u0440.
    \u041E\u043D\u044B\u04A3 \u04AF\u0441\u0442\u0456\u043D\u0435 \u0442\u04B1\u0440\u044B\u043F,
    \u0430\u043B\u0443 \u04AF\u0448\u0456\u043D \xAB\u04D8\u0440\u0435\u043A\u0435\u0442\xBB
    \u0431\u0430\u0441\u044B\u04A3\u044B\u0437.\n\u0411\u0456\u0440 \u0436\u0430\u049B\u044B\u043D
    \u04B1\u0440\u044B\u0441 \u049B\u0430\u0440\u0443\u044B\u043D \u0436\u04D9\u043D\u0435
    \u0431\u0456\u0440 \u0430\u0442\u044B\u0441 \u049B\u0430\u0440\u0443\u044B\u043D
    \u0430\u043B\u044B\u043F \u0436\u04AF\u0440\u0443\u0433\u0435 \u0431\u043E\u043B\u0430\u0434\u044B."
  - "\u049A\u0430\u0440\u0443\u0434\u044B \u0430\u043B\u044B\u04A3\u044B\u0437: E"
  - "\u049A\u0430\u0440\u0443\u0434\u044B \u0430\u043B\u044B\u04A3\u044B\u0437: \xAB\u04D8\u0440\u0435\u043A\u0435\u0442\xBB"
  - "\u0411\u04B1\u043B \u0435\u0441\u0456\u043A\u0442\u0456\u04A3 \u0430\u0440\u0442\u044B\u043D\u0434\u0430
    \u0437\u043E\u043C\u0431\u0438 \u0431\u0430\u0440! \u0421\u0430\u0440\u044B \u043A\u043E\u043D\u0443\u0441
    \u043E\u043D\u044B\u04A3 \u043D\u0435 \u043A\u04E9\u0440\u0435\u0442\u0456\u043D\u0456\u043D
    \u043A\u04E9\u0440\u0441\u0435\u0442\u0435\u0434\u0456: \u0456\u0448\u0456\u043D\u0435
    \u043A\u0456\u0440\u0441\u0435\u04A3\u0456\u0437, \u0437\u043E\u043C\u0431\u0438
    \u044B\u0440\u044B\u043B\u0434\u0430\u043F \u0448\u0430\u0431\u0443\u044B\u043B
    \u0436\u0430\u0441\u0430\u0439\u0434\u044B.\n\u0415\u0441\u0456\u043A\u0442\u0456
    \u0430\u0448\u044B\u043F, \u043E\u043D\u044B \u0411\u043E\u0441 \u043E\u0440\u044B\u043D
    \u043F\u0435\u0440\u043D\u0435\u0441\u0456\u043C\u0435\u043D \u043D\u0435\u043C\u0435\u0441\u0435
    \u0442\u0456\u043D\u0442\u0443\u0456\u0440\u0434\u0456\u04A3 \u0441\u043E\u043B
    \u0436\u0430\u049B \u0431\u0430\u0442\u044B\u0440\u043C\u0430\u0441\u044B\u043C\u0435\u043D
    \u04B1\u0440\u044B\u04A3\u044B\u0437."
  - "\u0411\u04B1\u043B \u0435\u0441\u0456\u043A\u0442\u0456\u04A3 \u0430\u0440\u0442\u044B\u043D\u0434\u0430
    \u0437\u043E\u043C\u0431\u0438 \u0431\u0430\u0440! \u0421\u0430\u0440\u044B \u043A\u043E\u043D\u0443\u0441
    \u043E\u043D\u044B\u04A3 \u043D\u0435 \u043A\u04E9\u0440\u0435\u0442\u0456\u043D\u0456\u043D
    \u043A\u04E9\u0440\u0441\u0435\u0442\u0435\u0434\u0456: \u0456\u0448\u0456\u043D\u0435
    \u043A\u0456\u0440\u0441\u0435\u04A3\u0456\u0437, \u0437\u043E\u043C\u0431\u0438
    \u044B\u0440\u044B\u043B\u0434\u0430\u043F \u0448\u0430\u0431\u0443\u044B\u043B
    \u0436\u0430\u0441\u0430\u0439\u0434\u044B.\n\u0415\u0441\u0456\u043A\u0442\u0456
    \u0430\u0448\u044B\u043F, \u043E\u043D\u044B \u043E\u04A3 \u0436\u0430\u049B\u0442\u0430\u0493\u044B
    \u04AF\u043B\u043A\u0435\u043D \u0428\u0430\u0431\u0443\u044B\u043B \u0431\u0430\u0442\u044B\u0440\u043C\u0430\u0441\u044B\u043C\u0435\u043D
    \u04B1\u0440\u044B\u04A3\u044B\u0437."
  - "\u0417\u043E\u043C\u0431\u0438\u0434\u0456 \u0436\u0435\u04A3\u0456\u04A3\u0456\u0437:
    \u0411\u043E\u0441 \u043E\u0440\u044B\u043D / \u0442\u0456\u043D\u0442\u0443\u0456\u0440\u0434\u0456\u04A3
    \u0441\u043E\u043B \u0436\u0430\u049B \u0431\u0430\u0442\u044B\u0440\u043C\u0430\u0441\u044B"
  - "\u0417\u043E\u043C\u0431\u0438\u0434\u0456 \u0436\u0435\u04A3\u0456\u04A3\u0456\u0437:
    \u0428\u0430\u0431\u0443\u044B\u043B \u0431\u0430\u0442\u044B\u0440\u043C\u0430\u0441\u044B"
  - "\u0410\u0442\u044B\u0441 \u049B\u0430\u0440\u0443\u044B! \u041E\u043B \u0430\u043B\u044B\u0441\u0442\u0430\u043D
    \u0442\u0438\u0435\u0434\u0456, \u0431\u0456\u0440\u0430\u049B \u043E\u049B\u0448\u0430\u043D\u0442\u0430\u0439\u044B
    \u0448\u0430\u0493\u044B\u043D: \u0431\u043E\u0441 \u0431\u043E\u043B\u0493\u0430\u043D\u0434\u0430
    \u04E9\u0437\u0456 \u043E\u049B\u0442\u0430\u043B\u0430\u0434\u044B \u043D\u0435\u043C\u0435\u0441\u0435
    R \u0431\u0430\u0441\u044B\u04A3\u044B\u0437.\n\u049A\u0430\u0440\u0443\u0434\u044B
    1 \u0436\u04D9\u043D\u0435 2 \u043F\u0435\u0440\u043D\u0435\u043B\u0435\u0440\u0456\u043C\u0435\u043D
    \u0430\u0443\u044B\u0441\u0442\u044B\u0440\u044B\u04A3\u044B\u0437."
  - "\u0410\u0442\u044B\u0441 \u049B\u0430\u0440\u0443\u044B! \u041E\u043B \u0430\u043B\u044B\u0441\u0442\u0430\u043D
    \u0442\u0438\u0435\u0434\u0456, \u0431\u0456\u0440\u0430\u049B \u043E\u049B\u0448\u0430\u043D\u0442\u0430\u0439\u044B
    \u0448\u0430\u0493\u044B\u043D: \u0431\u043E\u0441 \u0431\u043E\u043B\u0493\u0430\u043D\u0434\u0430
    \u04E9\u0437\u0456 \u043E\u049B\u0442\u0430\u043B\u0430\u0434\u044B \u043D\u0435\u043C\u0435\u0441\u0435
    \u043E\u043D\u044B\u04A3 \u04B1\u044F\u0448\u044B\u0493\u044B\u043D \u049B\u0430\u0439\u0442\u0430
    \u0431\u0430\u0441\u044B\u04A3\u044B\u0437.\n\u049A\u0430\u0440\u0443\u0434\u044B
    \u0428\u0430\u0431\u0443\u044B\u043B \u0431\u0430\u0442\u044B\u0440\u043C\u0430\u0441\u044B\u043D\u044B\u04A3
    \u0430\u0439\u043D\u0430\u043B\u0430\u0441\u044B\u043D\u0434\u0430\u0493\u044B
    \u04B1\u044F\u0448\u044B\u049B\u0442\u0430\u0440\u0434\u044B \u0431\u0430\u0441\u044B\u043F
    \u0430\u0443\u044B\u0441\u0442\u044B\u0440\u044B\u04A3\u044B\u0437."
  - "\u049A\u0430\u0440\u0443\u0434\u044B \u0430\u043B\u044B\u04A3\u044B\u0437: E"
  - "\u049A\u0430\u0440\u0443\u0434\u044B \u0430\u043B\u044B\u04A3\u044B\u0437: \xAB\u04D8\u0440\u0435\u043A\u0435\u0442\xBB"
  - "\u0414\u04D9\u043B\u0456\u0437\u0434\u0456\u04A3 \u0430\u0440\u044B \u0436\u0430\u0493\u044B\u043D\u0434\u0430
    \u0442\u0430\u0493\u044B \u0431\u0456\u0440 \u0437\u043E\u043C\u0431\u0438 \u0431\u0430\u0440.
    \u041E\u043B \u0435\u0448\u0442\u0435\u04A3\u0435 \u043A\u04E9\u0440\u043C\u0435\u0439\u0434\u0456,
    \u0431\u0456\u0440\u0430\u049B \u0436\u0430\u049B\u0441\u044B \u0435\u0441\u0442\u0438\u0434\u0456,
    \u0430\u043B \u0430\u0442\u044B\u0441 \u0434\u044B\u0431\u044B\u0441\u044B \u049B\u0430\u0442\u0442\u044B
    \u2014 \u043E\u043B \u0441\u0456\u0437\u0433\u0435 \u04E9\u0437\u0456 \u043A\u0435\u043B\u0435\u0434\u0456.\n\u0416\u0430\u049B\u044B\u043D\u0434\u0430\u043C\u0430\u0439
    \u0442\u04B1\u0440\u044B\u043F \u043E\u043D\u044B \u0430\u0442\u044B\u043F \u0442\u0430\u0441\u0442\u0430\u04A3\u044B\u0437."
  - "\u0417\u043E\u043C\u0431\u0438\u0434\u0456 \u0430\u0442\u044B\u04A3\u044B\u0437"
  - "\u0416\u0430\u0440\u0430\u043B\u0430\u043D\u0434\u044B\u04A3\u044B\u0437 \u0431\u0430?
    \u0414\u04D9\u0440\u0456 \u049B\u043E\u0440\u0430\u0431\u044B \u0442\u043E\u043B\u044B\u049B
    \u0435\u043C\u0434\u0435\u0439\u0434\u0456.\n\u041E\u043D\u044B\u04A3 \u04AF\u0441\u0442\u0456\u043D\u0435
    \u0431\u0430\u0441\u044B\u04A3\u044B\u0437 \u2014 \u043E\u043B \u0434\u0435\u043D\u0441\u0430\u0443\u043B\u044B\u049B
    \u0442\u043E\u043B\u044B\u049B \u0431\u043E\u043B\u043C\u0430\u0493\u0430\u043D\u0434\u0430
    \u0493\u0430\u043D\u0430 \u0436\u04B1\u043C\u0441\u0430\u043B\u0430\u0434\u044B."
  - "\u0414\u04D9\u0440\u0456 \u049B\u043E\u0440\u0430\u0431\u044B\u043D\u0430 \u0431\u0430\u0441\u044B\u04A3\u044B\u0437"
  - "\u0411\u04B1\u043B \u2014 \u043A\u0430\u0440\u0442\u0430 \u0431\u04E9\u043B\u0456\u0433\u0456.
    \u04D8\u0440\u049B\u0430\u0439\u0441\u044B\u0441\u044B \u0434\u0435\u04A3\u0433\u0435\u0439
    \u043A\u0430\u0440\u0442\u0430\u0441\u044B\u043D\u044B\u04A3 \u0431\u0456\u0440
    \u0431\u04E9\u043B\u0456\u0433\u0456\u043D \u0430\u0448\u0430\u0434\u044B."
  - "\u041A\u0430\u0440\u0442\u0430 \u0431\u04E9\u043B\u0456\u0433\u0456\u043D \u0430\u043B\u044B\u04A3\u044B\u0437"
  - "\u041A\u0430\u0440\u0442\u0430\u043D\u044B M \u043F\u0435\u0440\u043D\u0435\u0441\u0456\u043C\u0435\u043D
    \u043D\u0435\u043C\u0435\u0441\u0435 \u0436\u043E\u0493\u0430\u0440\u0493\u044B
    \u043E\u04A3 \u0436\u0430\u049B\u0442\u0430\u0493\u044B \u043A\u0430\u0440\u0442\u0430
    \u0431\u0430\u0442\u044B\u0440\u043C\u0430\u0441\u044B\u043C\u0435\u043D \u0430\u0448\u044B\u04A3\u044B\u0437.
    \u041A\u0430\u0440\u0442\u0430\u0434\u0430\u0493\u044B \u04B1\u043B\u0493\u0430\u0439\u0442\u049B\u044B\u0448
    \u0435\u04A3 \u0436\u0430\u049B\u044B\u043D \u043C\u0430\u049B\u0441\u0430\u0442\u049B\u0430
    \u0436\u043E\u043B\u0434\u044B \u043A\u04E9\u0440\u0441\u0435\u0442\u0435\u0434\u0456."
  - "\u041A\u0430\u0440\u0442\u0430\u043D\u044B \u0436\u043E\u0493\u0430\u0440\u0493\u044B
    \u043E\u04A3 \u0436\u0430\u049B\u0442\u0430\u0493\u044B \u043A\u0430\u0440\u0442\u0430
    \u0431\u0430\u0442\u044B\u0440\u043C\u0430\u0441\u044B\u043C\u0435\u043D \u0430\u0448\u044B\u04A3\u044B\u0437.
    \u041A\u0430\u0440\u0442\u0430\u0434\u0430\u0493\u044B \u04B1\u043B\u0493\u0430\u0439\u0442\u049B\u044B\u0448
