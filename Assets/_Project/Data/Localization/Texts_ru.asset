    \u0432 \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442! \u0412\u0430\u0448\u0430
    \u0446\u0435\u043B\u044C \u2014 \u043D\u0430\u0439\u0442\u0438 \u0432\u044B\u0445\u043E\u0434.\n\u0414\u0432\u0438\u0433\u0430\u0439\u0442\u0435\u0441\u044C
    \u043A\u043B\u0430\u0432\u0438\u0448\u0430\u043C\u0438 WASD \u0438\u043B\u0438
    \u0441\u0442\u0440\u0435\u043B\u043A\u0430\u043C\u0438 \u0438 \u0438\u0434\u0438\u0442\u0435
    \u043F\u043E \u0441\u0432\u0435\u0442\u044F\u0449\u0435\u0439\u0441\u044F \u043B\u0438\u043D\u0438\u0438."
  - "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
    \u0432 \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442! \u0412\u0430\u0448\u0430
    \u0446\u0435\u043B\u044C \u2014 \u043D\u0430\u0439\u0442\u0438 \u0432\u044B\u0445\u043E\u0434.\n\u0414\u0432\u0438\u0433\u0430\u0439\u0442\u0435\u0441\u044C
    \u0441\u0442\u0438\u043A\u043E\u043C \u0441\u043B\u0435\u0432\u0430 \u0438 \u0438\u0434\u0438\u0442\u0435
    \u043F\u043E \u0441\u0432\u0435\u0442\u044F\u0449\u0435\u0439\u0441\u044F \u043B\u0438\u043D\u0438\u0438."
  - "\u0418\u0434\u0438\u0442\u0435 \u043F\u043E \u043B\u0438\u043D\u0438\u0438"
  - "\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0434\u0432\u0435\u0440\u0438
    \u0437\u0430\u043F\u0435\u0440\u0442\u044B. \u041A\u043B\u044E\u0447 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
    \u043E\u0434\u043D\u0443 \u0434\u0432\u0435\u0440\u044C \u0441\u0432\u043E\u0435\u0433\u043E
    \u0446\u0432\u0435\u0442\u0430.\n\u0427\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C
    \u043A\u043B\u044E\u0447, \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u0442\u0435
    \u043D\u0430 \u043D\u0435\u0433\u043E."
  - "\u041F\u043E\u0434\u0431\u0435\u0440\u0438\u0442\u0435 \u043A\u043B\u044E\u0447"
  - "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u0434\u0432\u0435\u0440\u0438
    \u0446\u0432\u0435\u0442\u0430 \u043A\u043B\u044E\u0447\u0430 \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    E, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043F\u0435\u0440\u0435\u0442\u044C
    \u0435\u0451. \u041A\u043B\u044E\u0447 \u043F\u0440\u0438 \u044D\u0442\u043E\u043C
    \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442\u0441\u044F."
  - "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u0434\u0432\u0435\u0440\u0438
    \u0446\u0432\u0435\u0442\u0430 \u043A\u043B\u044E\u0447\u0430 \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    \xAB\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435\xBB (\u043A\u0440\u0443\u0433\u043B\u0430\u044F
    \u043A\u043D\u043E\u043F\u043A\u0430), \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043F\u0435\u0440\u0435\u0442\u044C
    \u0435\u0451. \u041A\u043B\u044E\u0447 \u043F\u0440\u0438 \u044D\u0442\u043E\u043C
    \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442\u0441\u044F."
  - "\u041E\u0442\u043E\u043F\u0440\u0438\u0442\u0435 \u0434\u0432\u0435\u0440\u044C:
    E"
  - "\u041E\u0442\u043E\u043F\u0440\u0438\u0442\u0435 \u0434\u0432\u0435\u0440\u044C:
    \xAB\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435\xBB"
  - "\u0414\u0432\u0435\u0440\u044C \u043E\u0442\u043F\u0435\u0440\u0442\u0430, \u043D\u043E
    \u0435\u0449\u0451 \u0437\u0430\u043A\u0440\u044B\u0442\u0430. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
    E \u0435\u0449\u0451 \u0440\u0430\u0437, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C
    \u0435\u0451. \u0414\u0432\u0435\u0440\u0438 \u043C\u043E\u0436\u043D\u043E \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C
    \u0438 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0443\u0433\u043E\u0434\u043D\u043E."
  - "\u0414\u0432\u0435\u0440\u044C \u043E\u0442\u043F\u0435\u0440\u0442\u0430, \u043D\u043E
    \u0435\u0449\u0451 \u0437\u0430\u043A\u0440\u044B\u0442\u0430. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
    \xAB\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435\xBB \u0435\u0449\u0451 \u0440\u0430\u0437,
    \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0435\u0451.
    \u0414\u0432\u0435\u0440\u0438 \u043C\u043E\u0436\u043D\u043E \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C
    \u0438 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0443\u0433\u043E\u0434\u043D\u043E."
  - "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u0434\u0432\u0435\u0440\u044C:
    E"
  - "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u0434\u0432\u0435\u0440\u044C:
    \xAB\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435\xBB"
  - "\u041E\u0440\u0443\u0436\u0438\u0435 \u043B\u0435\u0436\u0438\u0442 \u043D\u0430
    \u043F\u043E\u043B\u0443. \u0412\u0441\u0442\u0430\u043D\u044C\u0442\u0435 \u043D\u0430
    \u043D\u0435\u0433\u043E \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 E,
    \u0447\u0442\u043E\u0431\u044B \u0432\u0437\u044F\u0442\u044C.\n\u041C\u043E\u0436\u043D\u043E
    \u043D\u043E\u0441\u0438\u0442\u044C \u043E\u0434\u043D\u043E \u043E\u0440\u0443\u0436\u0438\u0435
    \u0431\u043B\u0438\u0436\u043D\u0435\u0433\u043E \u0431\u043E\u044F \u0438 \u043E\u0434\u043D\u043E
    \u043E\u0433\u043D\u0435\u0441\u0442\u0440\u0435\u043B\u044C\u043D\u043E\u0435."
  - "\u041E\u0440\u0443\u0436\u0438\u0435 \u043B\u0435\u0436\u0438\u0442 \u043D\u0430
    \u043F\u043E\u043B\u0443. \u0412\u0441\u0442\u0430\u043D\u044C\u0442\u0435 \u043D\u0430
    \u043D\u0435\u0433\u043E \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435\xBB,
    \u0447\u0442\u043E\u0431\u044B \u0432\u0437\u044F\u0442\u044C.\n\u041C\u043E\u0436\u043D\u043E
    \u043D\u043E\u0441\u0438\u0442\u044C \u043E\u0434\u043D\u043E \u043E\u0440\u0443\u0436\u0438\u0435
    \u0431\u043B\u0438\u0436\u043D\u0435\u0433\u043E \u0431\u043E\u044F \u0438 \u043E\u0434\u043D\u043E
    \u043E\u0433\u043D\u0435\u0441\u0442\u0440\u0435\u043B\u044C\u043D\u043E\u0435."
  - "\u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043E\u0440\u0443\u0436\u0438\u0435:
    E"
  - "\u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043E\u0440\u0443\u0436\u0438\u0435:
    \xAB\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435\xBB"
  - "\u0417\u0430 \u044D\u0442\u043E\u0439 \u0434\u0432\u0435\u0440\u044C\u044E \u0437\u043E\u043C\u0431\u0438!
    \u0416\u0451\u043B\u0442\u044B\u0439 \u043A\u043E\u043D\u0443\u0441 \u2014 \u0442\u043E,
    \u0447\u0442\u043E \u043E\u043D \u0432\u0438\u0434\u0438\u0442: \u043F\u043E\u043F\u0430\u0434\u0451\u0442\u0435
    \u0432 \u043D\u0435\u0433\u043E \u2014 \u0437\u043E\u043C\u0431\u0438 \u0437\u0430\u0440\u044B\u0447\u0438\u0442
    \u0438 \u043D\u0430\u043F\u0430\u0434\u0451\u0442.\n\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435
    \u0434\u0432\u0435\u0440\u044C \u0438 \u0431\u0435\u0439\u0442\u0435 \u0435\u0433\u043E
    \u043F\u0440\u043E\u0431\u0435\u043B\u043E\u043C \u0438\u043B\u0438 \u043B\u0435\u0432\u043E\u0439
    \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u043C\u044B\u0448\u0438."
  - "\u0417\u0430 \u044D\u0442\u043E\u0439 \u0434\u0432\u0435\u0440\u044C\u044E \u0437\u043E\u043C\u0431\u0438!
    \u0416\u0451\u043B\u0442\u044B\u0439 \u043A\u043E\u043D\u0443\u0441 \u2014 \u0442\u043E,
    \u0447\u0442\u043E \u043E\u043D \u0432\u0438\u0434\u0438\u0442: \u043F\u043E\u043F\u0430\u0434\u0451\u0442\u0435
    \u0432 \u043D\u0435\u0433\u043E \u2014 \u0437\u043E\u043C\u0431\u0438 \u0437\u0430\u0440\u044B\u0447\u0438\u0442
    \u0438 \u043D\u0430\u043F\u0430\u0434\u0451\u0442.\n\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435
    \u0434\u0432\u0435\u0440\u044C \u0438 \u0431\u0435\u0439\u0442\u0435 \u0435\u0433\u043E
    \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u043E\u0439
    \u0430\u0442\u0430\u043A\u0438 \u0441\u043F\u0440\u0430\u0432\u0430."
  - "\u041F\u043E\u0431\u0435\u0434\u0438\u0442\u0435 \u0437\u043E\u043C\u0431\u0438:
    \u043F\u0440\u043E\u0431\u0435\u043B / \u043B\u0435\u0432\u0430\u044F \u043A\u043D\u043E\u043F\u043A\u0430
    \u043C\u044B\u0448\u0438"
  - "\u041F\u043E\u0431\u0435\u0434\u0438\u0442\u0435 \u0437\u043E\u043C\u0431\u0438:
    \u043A\u043D\u043E\u043F\u043A\u0430 \u0430\u0442\u0430\u043A\u0438"
  - "\u041E\u0433\u043D\u0435\u0441\u0442\u0440\u0435\u043B\u044C\u043D\u043E\u0435
    \u043E\u0440\u0443\u0436\u0438\u0435! \u041E\u043D\u043E \u0431\u044C\u0451\u0442
    \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430, \u043D\u043E \u043C\u0430\u0433\u0430\u0437\u0438\u043D
    \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439: \u043E\u043D \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0436\u0430\u0435\u0442\u0441\u044F
    \u0441\u0430\u043C, \u043A\u043E\u0433\u0434\u0430 \u043F\u0443\u0441\u0442,
    \u0438\u043B\u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 R.\n\u041F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0439\u0442\u0435
    \u043E\u0440\u0443\u0436\u0438\u0435 \u043A\u043B\u0430\u0432\u0438\u0448\u0430\u043C\u0438
    1 \u0438 2."
  - "\u041E\u0433\u043D\u0435\u0441\u0442\u0440\u0435\u043B\u044C\u043D\u043E\u0435
    \u043E\u0440\u0443\u0436\u0438\u0435! \u041E\u043D\u043E \u0431\u044C\u0451\u0442
    \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430, \u043D\u043E \u043C\u0430\u0433\u0430\u0437\u0438\u043D
    \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439: \u043E\u043D \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0436\u0430\u0435\u0442\u0441\u044F
    \u0441\u0430\u043C, \u043A\u043E\u0433\u0434\u0430 \u043F\u0443\u0441\u0442,
    \u0438\u043B\u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u0435\u0433\u043E
    \u0441\u043B\u043E\u0442 \u0435\u0449\u0451 \u0440\u0430\u0437.\n\u041F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0439\u0442\u0435
    \u043E\u0440\u0443\u0436\u0438\u0435 \u043D\u0430\u0436\u0430\u0442\u0438\u0435\u043C
    \u043D\u0430 \u0441\u043B\u043E\u0442\u044B \u0432\u043E\u043A\u0440\u0443\u0433
    \u043A\u043D\u043E\u043F\u043A\u0438 \u0430\u0442\u0430\u043A\u0438."
  - "\u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043E\u0440\u0443\u0436\u0438\u0435:
    E"
  - "\u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043E\u0440\u0443\u0436\u0438\u0435:
    \xAB\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435\xBB"
  - "\u0414\u0430\u043B\u044C\u0448\u0435 \u043F\u043E \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0443
    \u0435\u0449\u0451 \u043E\u0434\u0438\u043D \u0437\u043E\u043C\u0431\u0438. \u042D\u0442\u043E\u0442
    \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0432\u0438\u0434\u0438\u0442,
    \u0437\u0430\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u043E \u0441\u043B\u044B\u0448\u0438\u0442,
    \u0430 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B \u0433\u0440\u043E\u043C\u043A\u0438\u0435
    \u2014 \u043E\u043D \u043F\u0440\u0438\u0434\u0451\u0442 \u043A \u0432\u0430\u043C.\n\u0417\u0430\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u0435
    \u0435\u0433\u043E, \u043F\u043E\u043A\u0430 \u043E\u043D \u043D\u0435 \u043F\u043E\u0434\u043E\u0448\u0451\u043B."
  - "\u0417\u0430\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u0435 \u0437\u043E\u043C\u0431\u0438"
  - "\u0420\u0430\u043D\u0435\u043D\u044B? \u0410\u043F\u0442\u0435\u0447\u043A\u0430
    \u043B\u0435\u0447\u0438\u0442 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E.\n\u041D\u0430\u0441\u0442\u0443\u043F\u0438\u0442\u0435
    \u043D\u0430 \u043D\u0435\u0451 \u2014 \u043E\u043D\u0430 \u0442\u0440\u0430\u0442\u0438\u0442\u0441\u044F,
    \u0442\u043E\u043B\u044C\u043A\u043E \u0435\u0441\u043B\u0438 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435
    \u043D\u0435 \u043F\u043E\u043B\u043D\u043E\u0435."
  - "\u041D\u0430\u0441\u0442\u0443\u043F\u0438\u0442\u0435 \u043D\u0430 \u0430\u043F\u0442\u0435\u0447\u043A\u0443"
  - "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u043A\u0430\u0440\u0442\u0443
    \u043A\u043B\u0430\u0432\u0438\u0448\u0435\u0439 M \u0438\u043B\u0438 \u043A\u043D\u043E\u043F\u043A\u043E\u0439
    \u043A\u0430\u0440\u0442\u044B \u0441\u043F\u0440\u0430\u0432\u0430 \u0432\u0432\u0435\u0440\u0445\u0443.
