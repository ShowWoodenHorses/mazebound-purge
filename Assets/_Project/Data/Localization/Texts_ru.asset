    \u043A\u0430\u0440\u0442\u044B \u0441\u043F\u0440\u0430\u0432\u0430 \u0432\u0432\u0435\u0440\u0445\u0443.
    \u041B\u0443\u043F\u0430 \u043D\u0430 \u043A\u0430\u0440\u0442\u0435 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u043F\u0443\u0442\u044C \u043A \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0439
    \u0446\u0435\u043B\u0438."
  - "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u043A\u0430\u0440\u0442\u0443
