    \u0431\u0440\u043E\u0441\u043A\u0430 \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F
    \u043F\u0435\u0440\u0432\u0430\u044F \u0432\u043E\u043B\u043D\u0430."
  - "\u041E\u0442\u0431\u0435\u0439\u0442\u0435 \u043F\u0435\u0440\u0432\u0443\u044E
    \u0432\u043E\u043B\u043D\u0443 \u0438 \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435
    \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u0443 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F."
  - "\u041C\u0435\u0436\u0434\u0443 \u0432\u043E\u043B\u043D\u0430\u043C\u0438 \u043F\u043E\u0434\u043E\u0436\u0434\u0438\u0442\u0435
    \u0438\u043B\u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C\xBB,
    \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C
    \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E."
  - "\u0421\u043B\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u043E\u0444\u0438\u0446\u0435\u0440\u043E\u043C-\u0434\u0430\u043B\u044C\u043D\u0438\u043A\u043E\u043C.
    \u041F\u0440\u0438 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0438
    \u043E\u0431 \u0430\u0442\u0430\u043A\u0435 \u0443\u0439\u0434\u0438\u0442\u0435
    \u0441 \u043B\u0438\u043D\u0438\u0438 \u043E\u0433\u043D\u044F. \u0417\u0430\u0447\u0438\u0441\u0442\u0438\u0442\u0435
    \u0432\u043E\u043B\u043D\u0443, \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C
    \u0438\u0442\u043E\u0433."
  - "\u0414\u043E\u0439\u0434\u0438\u0442\u0435 \u0434\u043E \u043E\u0442\u043C\u0435\u0442\u043A\u0438"
  - "\u041D\u0430\u043A\u043B\u043E\u043D\u0438\u0442\u0435 \u043F\u0440\u0430\u0432\u044B\u0439
    \u0441\u0442\u0438\u043A \u0434\u043B\u044F \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B.
    \u0412 \u0440\u0435\u0436\u0438\u043C\u0435 \u043E\u0434\u043D\u043E\u0433\u043E
    \u0441\u0442\u0438\u043A\u0430 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043A\u043D\u043E\u043F\u043A\u0443
    \u0430\u0442\u0430\u043A\u0438."
  - "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u043E\u043C\u0443
    \u043E\u0440\u0443\u0436\u0438\u044E \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    \u043A\u043D\u043E\u043F\u043A\u0443 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F."
  - "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439
    \u0441\u043B\u043E\u0442 \u043E\u0440\u0443\u0436\u0438\u044F."
  - "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043A\u043D\u043E\u043F\u043A\u0443
    \u0433\u0440\u0430\u043D\u0430\u0442\u044B, \u0437\u0430\u0442\u0435\u043C \u043A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C
    \u0442\u043E\u0447\u043A\u0438 \u0431\u0440\u043E\u0441\u043A\u0430. \u041F\u043E\u0441\u043B\u0435
    \u0431\u0440\u043E\u0441\u043A\u0430 \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F
    \u043F\u0435\u0440\u0432\u0430\u044F \u0432\u043E\u043B\u043D\u0430."
  - "\u0418\u0433\u0440\u043E\u0432\u044B\u0435 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438"
  - "\u041A\u0443\u043F\u0438 Desert, \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0447\u0430\u0442\u044C
    \u043F\u0435\u0440\u0432\u044B\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C."
  - "\u041F\u041E\u0414\u0421\u041A\u0410\u0417\u041A\u0410"
  - "\u0413\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442
    \u0448\u0443\u043C \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u0432: \u0442\u0435\u0431\u044F
    \u0443\u0441\u043B\u044B\u0448\u0438\u0442 \u043C\u0435\u043D\u044C\u0448\u0435
    \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u0432."
  - "\u041E\u0444\u0438\u0446\u0435\u0440-\u0414\u0430\u043B\u044C\u043D\u0438\u0439
    \u0430\u0442\u0430\u043A\u0443\u0435\u0442 \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430.
    \u0412\u044B\u0439\u0434\u0438 \u0438\u0437 \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u043E\u0439
    \u0437\u043E\u043D\u044B \u0434\u043E \u0430\u0442\u0430\u043A\u0438."
  - "\u0428\u0430\u043C\u0430\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
    \u043F\u0430\u0432\u0448\u0438\u0445 \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u0432.
    \u0423\u0441\u0442\u0440\u0430\u043D\u0438 \u0448\u0430\u043C\u0430\u043D\u0430,
    \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u043F\u043E\u0434\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435."
  - "\u0411\u0440\u043E\u043D\u0435\u043D\u043E\u0441\u0435\u0446 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
    \u043C\u0435\u043D\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430 \u0432 \u043B\u043E\u0431.
    \u0421\u0442\u0440\u0435\u043B\u044F\u0439 \u0441\u0431\u043E\u043A\u0443 \u0438\u043B\u0438
    \u0441\u043E \u0441\u043F\u0438\u043D\u044B."
  - "\u0423 \u0447\u0435\u043C\u043F\u0438\u043E\u043D\u043E\u0432 \u0435\u0441\u0442\u044C
    \u043E\u0441\u043E\u0431\u044B\u0435 \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0434\u0435\u043B\u0430\u044E\u0442
    \u0438\u0445 \u043E\u043F\u0430\u0441\u043D\u0435\u0435 \u043E\u0431\u044B\u0447\u043D\u044B\u0445
    \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u0432."
  - "\u041A\u0440\u044E\u043A \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u0442\u044F\u043D\u0443\u0442\u044C
    \u0442\u0435\u0431\u044F \u043A \u0441\u0435\u0431\u0435. \u0423\u0439\u0434\u0438
    \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u043A\u043E\u0433\u0434\u0430
    \u043E\u043D \u0433\u043E\u0442\u043E\u0432\u0438\u0442 \u0430\u0442\u0430\u043A\u0443."
  - "\u0412\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439
    \u0441 \u043E\u0431\u044B\u0447\u043D\u044B\u043C \u0441\u0443\u043D\u0434\u0443\u043A\u043E\u043C,
    \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0431\u0440\u0430\u0442\u044C \u043D\u0430\u0433\u0440\u0430\u0434\u0443."
  - "\u0414\u043B\u044F \u0437\u0430\u043F\u0435\u0440\u0442\u043E\u0433\u043E \u0441\u0443\u043D\u0434\u0443\u043A\u0430
    \u043D\u0443\u0436\u0435\u043D \u043A\u043B\u044E\u0447. \u0412\u043D\u0443\u0442\u0440\u0438
    \u043E\u0440\u0443\u0436\u0438\u0435 \u0431\u043E\u043B\u0435\u0435 \u0432\u044B\u0441\u043E\u043A\u043E\u0439
    \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u0438."
  - "\u042D\u0442\u043E\u0442 \u0441\u0443\u043D\u0434\u0443\u043A \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442
    \u0447\u0435\u043C\u043F\u0438\u043E\u043D\u043E\u0432. \u041F\u043E\u0431\u0435\u0434\u0438
    \u0438\u0445, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0431\u0440\u0430\u0442\u044C
    \u043D\u0430\u0433\u0440\u0430\u0434\u0443."
  - "\u042D\u0442\u0438\u043C \u043A\u043B\u044E\u0447\u043E\u043C \u043C\u043E\u0436\u043D\u043E
    \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0437\u0430\u043F\u0435\u0440\u0442\u044B\u0439
    \u0441\u0443\u043D\u0434\u0443\u043A."
  - "\u041A\u043E\u043B\u043F\u0430\u043A \u043D\u0435 \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442
    \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u0432 \u0438 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435. \u0412\u043E \u0432\u0440\u0435\u043C\u044F
    \u0432\u043E\u043B\u043D\u044B \u0432\u0440\u0435\u043C\u044F \u0432\u043D\u0443\u0442\u0440\u0438
    \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043E."
  - "\u0412\u044B\u0441\u0442\u0440\u0435\u043B\u0438 \u0432 \u0431\u043E\u0447\u043A\u0443,
    \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0437\u0432\u0430\u0442\u044C \u0435\u0451
    \u044D\u0444\u0444\u0435\u043A\u0442. \u0414\u0435\u0440\u0436\u0438\u0441\u044C
    \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435, \u043A\u043E\u0433\u0434\u0430
    \u043E\u043D\u0430 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
  - "\u0421\u0430\u0434\u0438\u0441\u044C \u0432 \u043C\u0430\u0448\u0438\u043D\u0443,
    \u0447\u0442\u043E\u0431\u044B \u0442\u0430\u0440\u0430\u043D\u0438\u0442\u044C
    \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u0432. \u041E\u0442 \u0441\u0438\u043B\u044C\u043D\u044B\u0445
    \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0439 \u043C\u0430\u0448\u0438\u043D\u0430
    \u043B\u043E\u043C\u0430\u0435\u0442\u0441\u044F."
  - "\u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F\u043C\u0438
    \u0431\u043E\u0441\u0441\u0430. \u0423\u0445\u043E\u0434\u0438 \u0438\u0437 \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u0445
    \u0437\u043E\u043D \u0434\u043E \u0443\u0434\u0430\u0440\u0430."
  - "\u0410\u0440\u0435\u043D\u0430 \u0437\u0430\u043F\u0435\u0440\u0442\u0430 \u0434\u043E
    \u043F\u043E\u0431\u0435\u0434\u044B \u043D\u0430\u0434 \u0431\u043E\u0441\u0441\u043E\u043C.
    \u0417\u0430 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u0437\u0430\u0431\u0435\u0433\u0430 \u0441 \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0439
    \u0430\u0440\u0435\u043D\u043E\u0439 \u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F
    \u0431\u043E\u043D\u0443\u0441."
  - "\u041D\u0430\u0441\u0442\u0443\u043F\u0438 \u043D\u0430 \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0443,
    \u0447\u0442\u043E\u0431\u044B \u043F\u0435\u0440\u0435\u0439\u0442\u0438 \u043D\u0430
    \u0434\u0440\u0443\u0433\u043E\u0439 \u044D\u0442\u0430\u0436. \u041C\u043E\u043D\u0441\u0442\u0440\u044B
    \u043C\u043E\u0433\u0443\u0442 \u043F\u043E\u0439\u0442\u0438 \u0441\u043B\u0435\u0434\u043E\u043C."
  - "\u0413\u043E\u0440\u0433\u0443\u043B\u044C\u044F"
  - "\u0412\u044B\u0439\u0434\u0438\u0442\u0435 \u0438\u0437 \u0442\u0435\u043D\u0438,
    \u043F\u043E\u043A\u0430 \u0413\u043E\u0440\u0433\u0443\u043B\u044C\u044F \u043D\u0435
    \u0441\u043F\u0438\u043A\u0438\u0440\u043E\u0432\u0430\u043B\u0430. \u041A\u0430\u043C\u0435\u043D\u043D\u0430\u044F
    \u043A\u043E\u0436\u0430 \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0441\u0435\u043A\u0443\u043D\u0434 \u043F\u043E\u0433\u043B\u043E\u0449\u0430\u0435\u0442
    \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0447\u0430\u0441\u0442\u044C \u0443\u0440\u043E\u043D\u0430."
  - "\u0422\u0438\u0445\u0430\u044F \u043E\u0445\u043E\u0442\u0430"
  - "\u0420\u0430\u0434\u0438\u0443\u0441 \u0448\u0443\u043C\u0430 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u0432
    \u221240%."
  - "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043F\u0430\u0442\u0440\u043E\u043D"
  - "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B
    \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435 \u043D\u0430\u043D\u043E\u0441\u0438\u0442
    +50% \u0443\u0440\u043E\u043D\u0430 (+15% \u0434\u043B\u044F \u043E\u0434\u043D\u043E\u0437\u0430\u0440\u044F\u0434\u043D\u043E\u0433\u043E
    \u043E\u0440\u0443\u0436\u0438\u044F)."
  - "\u0426\u0435\u043F\u043D\u0430\u044F \u0440\u0435\u0430\u043A\u0446\u0438\u044F"
  - "\u0423\u0431\u0438\u0439\u0441\u0442\u0432\u043E \u0432\u0437\u0440\u044B\u0432\u043E\u043C
    \u043D\u0430\u043D\u043E\u0441\u0438\u0442 40 \u0443\u0440\u043E\u043D\u0430
    \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C\u0443 \u043C\u043E\u043D\u0441\u0442\u0440\u0443
    \u0432 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445 2 \u043C. \u041E\u0434\u0438\u043D
    \u0440\u0430\u0437 \u0437\u0430 \u0432\u0437\u0440\u044B\u0432."
  - "\u041F\u0440\u043E\u043A\u043B\u044F\u0442\u044B\u0435"
  - "\u041E\u0440\u0443\u0436\u0438\u0435 \u043F\u043E\u043C\u0435\u0447\u0430\u0435\u0442
    \u0446\u0435\u043B\u044C \u043D\u0430 4 \u0441. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
    \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F \u043E\u0440\u0443\u0436\u0438\u0435\u043C
    \u043F\u043E \u043C\u0435\u0442\u043A\u0435 \u043D\u0430\u043D\u043E\u0441\u044F\u0442
    +15% \u0443\u0440\u043E\u043D\u0430."
  - "\u0425\u043E\u043B\u043E\u0434\u043D\u0430\u044F \u0433\u043E\u043B\u043E\u0432\u0430"
  - "\u0427\u0435\u0440\u0435\u0437 3 \u0441 \u0431\u0435\u0437 \u0443\u0440\u043E\u043D\u0430
    \u0448\u0430\u043D\u0441 \u043A\u0440\u0438\u0442\u0430 \u0440\u0430\u0441\u0442\u0451\u0442
    \u043D\u0430 10 \u043F. \u043F. \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
